# Mykronos backend configuration.
#
# Copy to `.env` and adjust. Every value has a working default, so an empty
# file is a valid configuration for local development.
#
# spec 12 §8: no real secret is ever committed, including in test fixtures.
# Nothing in this file is a secret today — ingestion tokens are minted with
# `mykronos mint-token` and live only in the local registry (hashed) and, from
# Phase 1, in GitHub Actions repo secrets.

# --- Data lake (spec 05 §2) -------------------------------------------------

# Root of the local lake. Relative paths resolve from the working directory.
MYKRONOS_DATALAKE_DIR=datalake

# How often the write-ahead buffer is folded into Parquet, in seconds.
# Spec 05 §9 requires writes to be queryable within 5 minutes of ingestion.
MYKRONOS_COMPACTION_INTERVAL_SECONDS=300

# Set false to disable the background compaction task and drive it manually
# with `mykronos compact`. Tests set this to keep assertions off a timer.
MYKRONOS_RUN_COMPACTION_IN_BACKGROUND=true

# --- Backpressure (spec 05 §6) ----------------------------------------------

MYKRONOS_MAX_FINDINGS_PER_REQUEST=10000
MYKRONOS_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# --- Ingestion tokens (spec 05 §4, spec 12 §2) ------------------------------

# Token hashes and capability grants live in the operational database, not a
# file (D-009/D-010). Only SHA-256 hashes are ever stored.

# Dual-validity window during rotation: a job that read the old secret before
# the swap still completes. 0 makes rotation a hard cutover.
MYKRONOS_TOKEN_OVERLAP_HOURS=24

# --- Operational state (D-010) ----------------------------------------------

# Onboarding, capability config, tokens, audit log. Separate from the data
# lake by design -- DuckDB is an OLAP engine and this is transactional state.
MYKRONOS_DATABASE_URL=sqlite:///mykronos.db

# --- GitHub App (spec 02 §4) -----------------------------------------------

# From the App's settings page. Leave both empty and GitHub calls are faked in
# memory, so the platform boots and the onboarding API is explorable before the
# App exists. Nothing real is touched in that mode.
MYKRONOS_GITHUB_APP_ID=
# Path to the downloaded .pem. The only long-lived secret in the system
# (spec 12 §2) -- keep it outside the repo, in a secret manager in production.
MYKRONOS_GITHUB_APP_PRIVATE_KEY_PATH=

# Host path to the App private key file. Read by deploy/mykronos/docker-compose.yml
# to bind-mount it at the path above. Not read by the application itself, which
# is why it is easy to forget -- and why compose now REFUSES to start without
# it rather than mounting an empty file and reporting healthy.
MYKRONOS_GITHUB_APP_KEY_HOST_PATH=

# The webhook secret you set when registering the App. Empty means webhooks are
# rejected with 503: without it there is no way to distinguish GitHub from
# anyone who found the URL, and that endpoint can create onboardings.
MYKRONOS_GITHUB_WEBHOOK_SECRET=

# --- Admin API (spec 12 §3) ------------------------------------------------

# PHASE 1 STUB. One token, one role. Empty disables the admin API entirely
# (503), so a deployment that forgets to set it is unusable rather than open.
# Replaced by SSO in Phase 7.
MYKRONOS_ADMIN_TOKEN=
MYKRONOS_ADMIN_IDENTITY=admin

# --- Workflow rendering ----------------------------------------------------

# Base URL rendered into every installed workflow, so onboarded repos know
# where to upload. Must be reachable from GitHub Actions runners.
MYKRONOS_INGESTION_API_URL=http://localhost:8000

# Semver-pinned reference to the shared upload action (spec 04 §2). Never a
# branch: every onboarded repo depends on it.
MYKRONOS_UPLOAD_ACTION_REF=ToddGBenson/mykronos/actions/upload-results@v1

# --- Perimeter gate (mykronos/gate.py) -------------------------------------
# One credential for the whole host, presented as X-Hub-Token, a hub_token
# cookie, or ?_token= — the same scheme as the sibling Hub service, so one
# value opens both. Empty disables the gate, which is right on a laptop and
# wrong the moment this is reachable from the internet.
#
# It is a perimeter, not an authorisation model: admin and viewer are still
# decided by the tokens above. Paths that carry their own proof are exempt —
# ingestion (per-repo token), the webhook (HMAC), and /healthz.
MYKRONOS_GATE_TOKEN=

# --- Ports -----------------------------------------------------------------
# 8100 rather than 8000, which the Hub holds on the reference deployment.
# Must be publicly resolvable in any real deployment: GitHub-hosted runners
# POST findings here and, unlike the webhook, there is no fallback if they
# cannot reach it.
MYKRONOS_INGESTION_API_URL=https://mykronos.example.net

# pip requirement the Aegis and Atlas workflows install for their collectors.
# Pinned to a tag, never a branch: every onboarded repo depends on it.
MYKRONOS_MYKRONOS_PACKAGE_SPEC=mykronos @ git+https://github.com/ToddGBenson/mykronos@v1#subdirectory=backend

# --- Policy files ----------------------------------------------------------
# Both default to the repository root and are versioned in git rather than
# stored in a database — a scoring rule or a definition of "good" that can be
# edited without review is one nobody can audit.
# MYKRONOS_ORACLE_POLICY_PATH=../oracle-policy-v1.yaml
# MYKRONOS_MATURITY_MODEL_PATH=../maturity-model-v1.yaml

# --- Retention -------------------------------------------------------------
# Insider-risk rows are about named people and expire (spec 06 §9). Everything
# else in the lake is evidence about code and is kept.
MYKRONOS_INSIDER_RISK_DEFAULT_RETENTION_DAYS=90
MYKRONOS_KNOWLEDGE_HALF_LIFE_DAYS=180

# ── Notifications ──────────────────────────────────────────────────────────
#
# Two independent switches, and one without the other is silent (#412).
#
# The TRANSPORT. Either the webhook alone, or the bot token WITH a channel —
# a token without a channel has nowhere to post. All three referenced by
# deploy/mykronos/docker-compose.yml; none of them was written down here,
# which is why the set required to make notifications work had to be
# reconstructed by reading the compose file against a running container.
MYKRONOS_SLACK_WEBHOOK_URL=
MYKRONOS_SLACK_BOT_TOKEN=
MYKRONOS_SLACK_CHANNEL=

# The floor a finding must reach before it is worth telling somebody about.
# Only means anything once a transport above is set.
MYKRONOS_SLACK_NOTIFY_MIN_SEVERITY=high

# The weekly owner digest. Off by default because it messages people. Turning
# it on with no transport set above builds digests and delivers none; the
# backend now says so at startup rather than once a week inside a job that
# reports success.
MYKRONOS_DIGEST_ENABLED=

# ── Referenced by deploy/mykronos/docker-compose.yml ───────────────────────
#
# These reach the container through compose interpolation. Several are not
# `Settings` fields an operator would find by reading the code, and every one
# of them was undocumented until a test started requiring it (#412, #664).

# Where the platform reads Concourse. Anonymous reads work, so these are
# URLs rather than credentials; the external one is what appears in links.
MYKRONOS_CONCOURSE_URL=
MYKRONOS_CONCOURSE_EXTERNAL_URL=
MYKRONOS_CONCOURSE_TEAM=

# Vault, for the pipelines' ((vars)). The platform does not read secrets from
# it; Concourse does.
MYKRONOS_VAULT_URL=

# Read-only API token. Separate from MYKRONOS_ADMIN_TOKEN so a dashboard or a
# script can be given one that cannot disposition a finding.
MYKRONOS_VIEWER_TOKEN=

# Which images the stack runs. UNSET MEANS `:latest`, which is whatever was
# built here last and not necessarily any commit — deploy by sha tag:
#
#   MYKRONOS_IMAGE_BACKEND=localhost:5000/mykronos-backend:<sha>
#
# Passing these through a shell that eats them is silent: compose falls back
# to `:latest`, the container starts, and the deploy did not happen.
MYKRONOS_IMAGE_BACKEND=
MYKRONOS_IMAGE_FRONTEND=

# Whether the auto-routing sweep opens a GitHub issue per finding group.
# OFF by default and worth leaving off without a cap: on 2026-09-18 a scan
# widened from 2 to 4,642 open container findings and this filed 141 issues
# onto a public tracker in three hours, with 3,439 still queued (#663).
MYKRONOS_ROUTING_ENABLED=
