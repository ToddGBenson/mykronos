# docs/DECISIONS.md is append-only and every pull request appends to its end,
# so any two open PRs conflict there. `union` keeps both sides' lines.
#
# GitHub's merge button runs no merge drivers: this applies to local git
# merges only - which is what scripts/approval-queue.ps1 makes, from main's
# side so main's entries stay first (D-149). Union never refuses, so the
# queue reads the result back (scripts/approval_queue.py check-decisions)
# before it pushes anything.
docs/DECISIONS.md merge=union

# The harness hooks run under bash, which fails on a CRLF line ending (TheHub #61099).
.claude/hooks/*.sh text eol=lf

# Semgrep fixture output: byte offsets and columns assume LF (TheHub #60746).
backend/tests/fixtures/semgrep_fix/** -text

# A worker install script that the operator runs with bash on Linux (TheHub #61659).
deploy/concourse/linux-worker/*.sh text eol=lf
