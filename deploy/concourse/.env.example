# Written by setup.ps1; only the bind addresses are documented here.
# Bind address for the Concourse web port (8080).
# Loopback by default; set 0.0.0.0 only on a host whose firewall scopes these ports to the named runner (operator decision 2026-11-14).
CONCOURSE_BIND=127.0.0.1

# Bind address for the Concourse TSA (2222), for a worker on another host (D-181).
# Loopback by default; Add-LinuxWorker.ps1 sets it to this host's LAN address only after the block rule on 2222 is in place.
CONCOURSE_TSA_BIND_IP=127.0.0.1
