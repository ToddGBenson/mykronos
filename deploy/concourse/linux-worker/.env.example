# Copy to .env beside docker-compose.yml. .env is gitignored: this repo is
# public, so the router and ISP addresses of the host live only in that file.

# The Concourse web node's TSA, reached over the LAN: <address>:2222.
CONCOURSE_TSA_HOST=

# This host's worker names, as `fly workers` lists them (linux-1, linux-2, linux-3).
WORKER_NAME_1=
WORKER_NAME_2=

# What task containers resolve through, tried in this order.
# 1. The LAN router. 2. The ISP resolver. 3. A public resolver as the last resort.
# The first two are required and left empty here so a missing value is an error.
WORKER_DNS_1=
WORKER_DNS_2=
WORKER_DNS_3=8.8.8.8

# Hostnames the DNS check also resolves (space separated), for example the
# MyKronos backend's name. registry-1.docker.io is always checked.
CHECK_HOSTS=
