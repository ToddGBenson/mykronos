# TheHub deploy target (spec 16 section 7).
#
# Copy to `.env` next to this file and fill in the paths for this host. Nothing
# here is a credential: it is a map of where the two environments live. The
# deploy keys are in deploy/concourse/keys/ and the Azure principal is in
# deploy/concourse/.env.
#
# Pulled from localhost rather than the host IP the pipeline pushes to. Docker
# treats localhost as an insecure registry by default, so no daemon
# configuration is needed here.
THEHUB_REGISTRY=localhost:5000

# TheHub's own compose files, on this host. Each must take its image from
# ${THEHUB_IMAGE} - that is the one change this deploy model asks of TheHub,
# and it is what makes "deploy" mean "run exactly this commit".
#
# The two environments need separate volumes as well as separate projects. A
# demo stack sharing production's database is a production environment with
# weaker controls and a different name.
THEHUB_DEMO_COMPOSE=C:\path\to\TheHub\docker-compose.demo.yml
THEHUB_DEMO_PROJECT=thehub-demo
THEHUB_DEMO_URL=http://localhost:8200

THEHUB_PROD_COMPOSE=C:\path\to\TheHub\docker-compose.yml
THEHUB_PROD_PROJECT=thehub-prod
THEHUB_PROD_URL=http://localhost:8000
