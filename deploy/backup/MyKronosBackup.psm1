<#
    Shared pieces of the Mykronos backup chain (TheHub #60842).

    Backup-MyKronos.ps1 (create) and Test-MyKronosRestore.ps1 (restore drill)
    both import this module. Everything that decides something -- what a
    manifest must contain to count as a backup, which local sets may be
    deleted, what a drill result means -- lives here as a pure function, so
    backend/tests/test_backup_scripts.py can drive it without Docker, Azure
    or a key.

    -- ENCRYPTION: TheHub's HUBENC1 format, byte for byte ------------------

    TheHub's backend/services/backup_encryption.py defines the format and this
    is a second implementation of it, in PowerShell, so the two estates share
    one codec and one decrypt tool:

        b"HUBENC1\n"                        8-byte magic
        <uint32 BE len><Fernet token>       header: {"v","sha256","size","chunk"}
        <uint32 BE len><Fernet token>  ...  one frame per plaintext chunk

    The header carries the plaintext length and SHA-256 because Fernet
    authenticates each frame on its own: drop the trailing frames and every
    remaining frame still verifies. Truncation (an upload or a disk that
    stopped mid-write) is the likeliest real corruption, so Unprotect-BackupFile
    checks both before it calls a restore good. A test round-trips archives
    between this file and Python's `cryptography` Fernet in both directions.

    Fernet tokens are never given a TTL on decrypt: a TTL is a silent expiry
    date on every archive.

    The key is a url-safe base64 32-byte Fernet key and this module never
    mints one. A key generated by a process and not recorded elsewhere is an
    archive nobody can open.

    -- WHAT NEVER REACHES A LOG -------------------------------------------

    The key, and the SAS query string. Get-SafeContainerUrl is the only form
    of the container URL that is printed or written to a manifest.
#>

Set-StrictMode -Version Latest

$script:Magic = [byte[]][char[]]"HUBENC1`n"
$script:EncryptedSuffix = '.hubenc'
$script:DefaultChunkBytes = 4 * 1024 * 1024
$script:MaxFrameBytes = 64 * 1024 * 1024
$script:BlobApiVersion = '2021-08-06'
$script:SetNamePattern = '^mykronos_(\d{8})_(\d{6})$'

# The four components a backup must contain to be called one. A manifest
# missing any of them is a failed backup, not a smaller one.
$script:RequiredComponents = @('operational-db', 'datalake', 'minio', 'vault-storage')

# Not backed up, and why. Written into every manifest so the answer to "is X
# in the backup?" is in the backup.
$script:Exclusions = @(
    [ordered]@{
        name   = 'registry'
        volume = 'mykronos-concourse_registry-data'
        reason = 'Every image in it is rebuilt from source by the pipelines (mykronos, thehub, personal-soc). 83 GB measured 2026-10-18 -- roughly 20x everything else combined -- for content that is reproducible. After a loss, deploys that pull a pinned digest fail until the image is rebuilt and pushed.'
    }
    [ordered]@{
        name   = 'concourse-db'
        volume = 'mykronos-concourse_concourse-db-data'
        reason = 'Pipelines are set from deploy/concourse/pipelines in the repo (set-pipeline.ps1); build history and resource versions regenerate. Secrets the pipelines resolve live in Vault, which is backed up.'
    }
    [ordered]@{
        name   = 'concourse-worker-data'
        volume = 'mykronos-concourse_concourse-worker-data, mykronos-concourse_concourse-worker-2-data'
        reason = 'Worker caches; rebuilt on the next build.'
    }
    [ordered]@{
        name   = 'trivy-cache'
        volume = 'mykronos-agent-trivy-cache'
        reason = 'Vulnerability-database cache; re-downloaded on the next scan.'
    }
    [ordered]@{
        name   = 'vault-unseal-key-and-root-token'
        volume = 'deploy/concourse/vault/init.json (a file in the checkout, not a volume)'
        reason = 'Never copied by this chain. A backup that holds both the sealed storage and the key that opens it protects nothing. Keep init.json off this host separately (#60836); restoring vault-storage needs it.'
    }
)

function Get-BackupExclusion {
    <#
    .SYNOPSIS
        What the backup deliberately leaves out, and why.
    #>
    return $script:Exclusions
}
function Get-RequiredComponent {
    <#
    .SYNOPSIS
        The components a set must contain to count as a backup.
    #>
    return $script:RequiredComponents
}
function Get-EncryptedSuffix {
    <#
    .SYNOPSIS
        The suffix an encrypted member carries (.hubenc).
    #>
    return $script:EncryptedSuffix
}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

function Write-BackupLog {
    <#
    .SYNOPSIS
        One timestamped line to stdout and, when a path is given, to the log.
    #>
    param(
        [Parameter(Mandatory)] [string] $Message,
        [string] $LogPath
    )
    $line = '[{0}] {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
    [Console]::Out.WriteLine($line)
    if ($LogPath) { Add-Content -LiteralPath $LogPath -Value $line -Encoding ascii }
}

# ---------------------------------------------------------------------------
# Fernet + HUBENC1
# ---------------------------------------------------------------------------

function ConvertTo-Base64Url {
    <#
    .SYNOPSIS
        Url-safe base64, padding kept, as Fernet emits it.
    #>
    param([Parameter(Mandatory)] [byte[]] $Bytes)
    # Padding kept: Python's urlsafe_b64encode keeps it and Fernet emits it.
    return [Convert]::ToBase64String($Bytes).Replace('+', '-').Replace('/', '_')
}

function ConvertFrom-Base64Url {
    <#
    .SYNOPSIS
        Decode url-safe base64, tolerating missing padding.
    #>
    param([Parameter(Mandatory)] [string] $Text)
    $t = $Text.Trim().Replace('-', '+').Replace('_', '/')
    switch ($t.Length % 4) {
        2 { $t += '==' }
        3 { $t += '=' }
    }
    # FromBase64CharArray, not FromBase64String: PowerShell 7 hands every
    # string argument of a .NET method call to AMSI, which costs ~0.5 s per
    # 5 MB frame. A char[] argument is not scanned. Measured 2026-10-18.
    return , [Convert]::FromBase64CharArray($t.ToCharArray(), 0, $t.Length)
}

function Get-FernetKey {
    <#
    .SYNOPSIS
        Parse a Fernet key into its two halves. Every failure names the SETTING
        and never the value: an error string is the easiest way for a key to
        reach a log file.
    #>
    param([Parameter(Mandatory)] [AllowEmptyString()] [string] $Key)
    if (-not $Key.Trim()) {
        throw 'MYKRONOS_BACKUP_ENCRYPTION_KEY is not set - refusing to write a backup in the clear'
    }
    try { $raw = ConvertFrom-Base64Url -Text $Key } catch { $raw = $null }
    if ($null -eq $raw -or $raw.Length -ne 32) {
        throw 'MYKRONOS_BACKUP_ENCRYPTION_KEY is not a valid Fernet key (expected url-safe base64 of 32 bytes)'
    }
    return [pscustomobject]@{
        Signing    = [byte[]]$raw[0..15]
        Encryption = [byte[]]$raw[16..31]
    }
}

function Get-KeyFingerprint {
    <#
    .SYNOPSIS
        A short, one-way label for the key, recorded in the manifest so that
        after a rotation the operator can tell which key a set needs. It is a
        hash of a 256-bit random value: it identifies the key, it does not
        weaken it.
    #>
    param([Parameter(Mandatory)] [string] $Key)
    $bytes = [Text.Encoding]::ASCII.GetBytes('mykronos-backup-key-id:' + $Key.Trim())
    $hash = [Security.Cryptography.SHA256]::HashData($bytes)
    return ([Convert]::ToHexString($hash).ToLowerInvariant()).Substring(0, 16)
}

function ConvertTo-BigEndianByte {
    <#
    .SYNOPSIS
        The low Width bytes of Value, big-endian.
    #>
    param([Parameter(Mandatory)] [long] $Value, [Parameter(Mandatory)] [int] $Width)
    $b = [BitConverter]::GetBytes($Value)
    if ([BitConverter]::IsLittleEndian) { [Array]::Reverse($b) }
    return , [byte[]]$b[(8 - $Width)..7]
}

function ConvertTo-FernetToken {
    <#
    .SYNOPSIS
        Fernet spec: 0x80 | ts(8, BE) | IV(16) | AES-128-CBC(PKCS7) | HMAC-SHA256(32).
    #>
    param(
        [Parameter(Mandatory)] $KeyParts,
        [Parameter(Mandatory)] [AllowEmptyCollection()] [byte[]] $Data
    )
    $iv = [Security.Cryptography.RandomNumberGenerator]::GetBytes(16)
    $aes = [Security.Cryptography.Aes]::Create()
    try {
        $aes.Key = $KeyParts.Encryption
        $cipher = $aes.EncryptCbc($Data, $iv, [Security.Cryptography.PaddingMode]::PKCS7)
    } finally { $aes.Dispose() }
    $ts = ConvertTo-BigEndianByte -Value ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds()) -Width 8
    $body = New-Object byte[] (1 + 8 + 16 + $cipher.Length)
    $body[0] = 0x80
    [Array]::Copy($ts, 0, $body, 1, 8)
    [Array]::Copy($iv, 0, $body, 9, 16)
    [Array]::Copy($cipher, 0, $body, 25, $cipher.Length)
    $mac = [Security.Cryptography.HMACSHA256]::HashData($KeyParts.Signing, $body)
    $token = New-Object byte[] ($body.Length + 32)
    [Array]::Copy($body, 0, $token, 0, $body.Length)
    [Array]::Copy($mac, 0, $token, $body.Length, 32)
    # .ToCharArray(): see ConvertFrom-Base64Url for why a big string is never
    # passed to a .NET method here.
    return , [Text.Encoding]::ASCII.GetBytes((ConvertTo-Base64Url -Bytes $token).ToCharArray())
}

function ConvertFrom-FernetToken {
    <#
    .SYNOPSIS
        Verify and open one token. No TTL, deliberately.
    #>
    param(
        [Parameter(Mandatory)] $KeyParts,
        [Parameter(Mandatory)] [byte[]] $Token
    )
    try { $raw = ConvertFrom-Base64Url -Text ([Text.Encoding]::ASCII.GetString($Token)) } catch { $raw = $null }
    if ($null -eq $raw -or $raw.Length -lt (1 + 8 + 16 + 16 + 32) -or $raw[0] -ne 0x80) {
        throw 'a frame is not a Fernet token - the archive is damaged or not a Mykronos/Hub backup'
    }
    $bodyLen = $raw.Length - 32
    $body = New-Object byte[] $bodyLen
    [Array]::Copy($raw, 0, $body, 0, $bodyLen)
    $mac = New-Object byte[] 32
    [Array]::Copy($raw, $bodyLen, $mac, 0, 32)
    $expected = [Security.Cryptography.HMACSHA256]::HashData($KeyParts.Signing, $body)
    if (-not [Security.Cryptography.CryptographicOperations]::FixedTimeEquals($mac, $expected)) {
        throw 'a frame did not authenticate - wrong key, or the archive has been altered'
    }
    $iv = New-Object byte[] 16
    [Array]::Copy($body, 9, $iv, 0, 16)
    $cipher = New-Object byte[] ($bodyLen - 25)
    [Array]::Copy($body, 25, $cipher, 0, $cipher.Length)
    $aes = [Security.Cryptography.Aes]::Create()
    try {
        $aes.Key = $KeyParts.Encryption
        return , $aes.DecryptCbc($cipher, $iv, [Security.Cryptography.PaddingMode]::PKCS7)
    } finally { $aes.Dispose() }
}

function Write-Frame {
    <#
    .SYNOPSIS
        Write one length-prefixed frame.
    #>
    param([Parameter(Mandatory)] [IO.Stream] $Stream, [Parameter(Mandatory)] [byte[]] $Token)
    $len = ConvertTo-BigEndianByte -Value $Token.Length -Width 4
    $Stream.Write($len, 0, 4)
    $Stream.Write($Token, 0, $Token.Length)
}

function Read-StreamExact {
    <#
    .SYNOPSIS
        Read up to Count bytes, looping over short reads; shorter only at end of stream.
    #>
    param([Parameter(Mandatory)] [IO.Stream] $Stream, [Parameter(Mandatory)] [int] $Count)
    $buf = New-Object byte[] $Count
    $got = 0
    while ($got -lt $Count) {
        $n = $Stream.Read($buf, $got, $Count - $got)
        if ($n -le 0) { break }
        $got += $n
    }
    if ($got -eq $Count) { return , $buf }
    $short = New-Object byte[] $got
    if ($got -gt 0) { [Array]::Copy($buf, 0, $short, 0, $got) }
    return , $short
}

function Read-Frame {
    <#
    .SYNOPSIS
        Read one length-prefixed frame, refusing truncation and implausible lengths.
    #>
    param([Parameter(Mandatory)] [IO.Stream] $Stream, [Parameter(Mandatory)] [string] $What)
    $hdr = Read-StreamExact -Stream $Stream -Count 4
    if ($hdr.Length -lt 4) {
        throw "archive ended before its $What - it is truncated and must not be treated as a restorable backup"
    }
    $b = [byte[]]$hdr.Clone()
    if ([BitConverter]::IsLittleEndian) { [Array]::Reverse($b) }
    $length = [BitConverter]::ToUInt32($b, 0)
    if ($length -eq 0 -or $length -gt $script:MaxFrameBytes) {
        throw "archive declares an implausible $What length ($length bytes)"
    }
    $token = Read-StreamExact -Stream $Stream -Count ([int]$length)
    if ($token.Length -lt $length) { throw "archive ended mid-$What - it is truncated" }
    return , $token
}

function Resolve-FullPath {
    <#
    .SYNOPSIS
        Absolute path for the .NET file APIs, which resolve against the process directory, not the PowerShell location.
    #>
    param([Parameter(Mandatory)] [string] $Path)
    return $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path)
}

function Get-FileSha256 {
    <#
    .SYNOPSIS
        Lower-case hex SHA-256 of a file.
    #>
    param([Parameter(Mandatory)] [string] $Path)
    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
}

function Clear-PartialFile {
    <#
    .SYNOPSIS
        Delete a partial artifact, never masking the error already being raised.
    #>
    param([string] $Path)
    if ($Path -and (Test-Path -LiteralPath $Path)) {
        Remove-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
    }
}

function Protect-BackupFile {
    <#
    .SYNOPSIS
        Encrypt Path to Destination in HUBENC1. A failure removes the partial
        output: a step that failed must leave nothing behind that can be
        mistaken for a step that worked.
    #>
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [string] $Destination,
        [Parameter(Mandatory)] [string] $Key,
        [int] $ChunkBytes = $script:DefaultChunkBytes
    )
    $parts = Get-FernetKey -Key $Key
    $Path = Resolve-FullPath -Path $Path
    $Destination = Resolve-FullPath -Path $Destination
    $sha = Get-FileSha256 -Path $Path
    $size = (Get-Item -LiteralPath $Path).Length
    # Same keys and order as Python's json.dumps(sort_keys=True).
    $header = '{{"chunk": {0}, "sha256": "{1}", "size": {2}, "v": 1}}' -f $ChunkBytes, $sha, $size
    $frames = 0
    $fin = $null; $fout = $null
    try {
        $fin = [IO.File]::OpenRead($Path)
        $fout = [IO.File]::Create($Destination)
        $fout.Write($script:Magic, 0, $script:Magic.Length)
        Write-Frame -Stream $fout -Token (ConvertTo-FernetToken -KeyParts $parts -Data ([Text.Encoding]::UTF8.GetBytes($header)))
        while ($true) {
            $block = Read-StreamExact -Stream $fin -Count $ChunkBytes
            if ($block.Length -eq 0) { break }
            Write-Frame -Stream $fout -Token (ConvertTo-FernetToken -KeyParts $parts -Data $block)
            $frames++
        }
    } catch {
        if ($fout) { $fout.Dispose(); $fout = $null }
        Clear-PartialFile -Path $Destination
        throw
    } finally {
        if ($fin) { $fin.Dispose() }
        if ($fout) { $fout.Dispose() }
    }
    return [pscustomobject]@{
        Path           = $Destination
        PlaintextBytes = $size
        PlaintextSha256 = $sha
        Frames         = $frames
    }
}

function Unprotect-BackupFile {
    <#
    .SYNOPSIS
        Restore Path to Destination, or throw and leave nothing behind. The
        size and digest checks at the end are the point: without them a
        truncated archive restores a short, structurally valid prefix.
    #>
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [string] $Destination,
        [Parameter(Mandatory)] [string] $Key
    )
    $parts = Get-FernetKey -Key $Key
    $Path = Resolve-FullPath -Path $Path
    $Destination = Resolve-FullPath -Path $Destination
    $fin = $null; $fout = $null
    $hasher = [Security.Cryptography.IncrementalHash]::CreateHash([Security.Cryptography.HashAlgorithmName]::SHA256)
    $written = [long]0
    try {
        $fin = [IO.File]::OpenRead($Path)
        $magic = Read-StreamExact -Stream $fin -Count $script:Magic.Length
        if (-not [Linq.Enumerable]::SequenceEqual([byte[]]$magic, [byte[]]$script:Magic)) {
            throw 'not a HUBENC1 backup archive (bad magic) - refusing to guess at the format'
        }
        $meta = [Text.Encoding]::UTF8.GetString((ConvertFrom-FernetToken -KeyParts $parts -Token (Read-Frame -Stream $fin -What 'header'))) | ConvertFrom-Json
        if ($meta.v -ne 1) { throw "unsupported archive version $($meta.v)" }
        $fout = [IO.File]::Create($Destination)
        while ($fin.Position -lt $fin.Length) {
            $block = ConvertFrom-FernetToken -KeyParts $parts -Token (Read-Frame -Stream $fin -What 'frame')
            $fout.Write($block, 0, $block.Length)
            $hasher.AppendData($block)
            $written += $block.Length
        }
        $fout.Dispose(); $fout = $null
        $digest = [Convert]::ToHexString($hasher.GetHashAndReset()).ToLowerInvariant()
        if ($written -ne [long]$meta.size) {
            throw "archive declares $($meta.size) plaintext bytes but produced $written - it is truncated or reordered"
        }
        if ($digest -ne $meta.sha256) {
            throw 'restored bytes do not match the SHA-256 recorded when the archive was written'
        }
    } catch {
        if ($fout) { $fout.Dispose(); $fout = $null }
        Clear-PartialFile -Path $Destination
        throw
    } finally {
        if ($fin) { $fin.Dispose() }
        if ($fout) { $fout.Dispose() }
        $hasher.Dispose()
    }
    return [pscustomobject]@{ Path = $Destination; PlaintextBytes = $written; PlaintextSha256 = $digest }
}

# ---------------------------------------------------------------------------
# Secrets: environment first, then this user's DPAPI-protected file
# ---------------------------------------------------------------------------

function Get-DefaultSecretPath {
    <#
    .SYNOPSIS
        This user's DPAPI-protected secrets file.
    #>
    $base = [Environment]::GetFolderPath([Environment+SpecialFolder]::LocalApplicationData)
    return Join-Path (Join-Path $base 'mykronos-backup') 'secrets.clixml'
}

function Get-BackupSecret {
    <#
    .SYNOPSIS
        Returns EncryptionKey, WriteSasUrl, ReadSasUrl (each may be empty).
        Environment variables win so a test or an interactive run can supply
        them; the scheduled task reads the file Register-MyKronosBackupTasks.ps1
        -SetSecrets wrote, which only this Windows user can decrypt.
    #>
    param([string] $SecretPath = (Get-DefaultSecretPath))
    $stored = @{}
    if ($SecretPath -and (Test-Path -LiteralPath $SecretPath)) {
        $raw = Import-Clixml -LiteralPath $SecretPath
        foreach ($k in @($raw.Keys)) {
            $v = $raw[$k]
            if ($v -is [securestring]) { $v = ConvertFrom-SecureString -SecureString $v -AsPlainText }
            $stored[$k] = [string]$v
        }
    }
    $pick = {
        param($envName, $fileKey)
        $e = [Environment]::GetEnvironmentVariable($envName)
        if ($e) { return $e }
        if ($stored.ContainsKey($fileKey)) { return $stored[$fileKey] }
        return ''
    }
    return [pscustomobject]@{
        EncryptionKey = & $pick 'MYKRONOS_BACKUP_ENCRYPTION_KEY' 'EncryptionKey'
        WriteSasUrl   = & $pick 'MYKRONOS_BACKUP_SAS_URL' 'WriteSasUrl'
        ReadSasUrl    = & $pick 'MYKRONOS_BACKUP_READ_SAS_URL' 'ReadSasUrl'
    }
}

# ---------------------------------------------------------------------------
# Azure Blob over REST, with a container-scoped SAS
# ---------------------------------------------------------------------------

function Split-SasUrl {
    <#
    .SYNOPSIS
        Split a container SAS URL into its base and its query string.
    #>
    param([Parameter(Mandatory)] [string] $SasUrl)
    $i = $SasUrl.IndexOf('?')
    if ($i -lt 0) { throw 'the SAS URL has no query string - expected https://<account>.blob.core.windows.net/<container>?sv=...&sig=...' }
    return [pscustomobject]@{ Base = $SasUrl.Substring(0, $i).TrimEnd('/'); Query = $SasUrl.Substring($i + 1) }
}

function Get-SafeContainerUrl {
    <#
    .SYNOPSIS
        The only printable form: scheme, host and container. Never the signature.
    #>
    param([string] $SasUrl)
    if (-not $SasUrl) { return '' }
    return (Split-SasUrl -SasUrl $SasUrl).Base
}

function Get-SasExpiry {
    <#
    .SYNOPSIS
        The `se` parameter as a UTC DateTime, or $null when absent/unparseable.
    #>
    param([string] $SasUrl)
    if (-not $SasUrl) { return $null }
    foreach ($pair in (Split-SasUrl -SasUrl $SasUrl).Query.Split('&')) {
        if ($pair.StartsWith('se=')) {
            $v = [Uri]::UnescapeDataString($pair.Substring(3))
            $parsed = [DateTimeOffset]::MinValue
            if ([DateTimeOffset]::TryParse($v, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::AssumeUniversal, [ref]$parsed)) {
                return $parsed.UtcDateTime
            }
        }
    }
    return $null
}

function Get-BlobUri {
    <#
    .SYNOPSIS
        The URI of one blob, with the SAS query and any extra parameters.
    #>
    param([Parameter(Mandatory)] $Sas, [Parameter(Mandatory)] [string] $BlobName, [string] $Extra)
    $path = ($BlobName.Split('/') | ForEach-Object { [Uri]::EscapeDataString($_) }) -join '/'
    $q = $Sas.Query
    if ($Extra) { $q = "$q&$Extra" }
    return "$($Sas.Base)/$path`?$q"
}

function Send-BlobFile {
    <#
    .SYNOPSIS
        Upload one file as a block blob (Put Block + Put Block List), so size
        is bounded by 50,000 blocks rather than the single-PUT limit. Each
        block is retried; the blob only exists once the list commits, so a
        failed upload leaves no half-blob that looks like a whole one.
    #>
    param(
        [Parameter(Mandatory)] [string] $SasUrl,
        [Parameter(Mandatory)] [string] $BlobName,
        [Parameter(Mandatory)] [string] $Path,
        [int] $BlockBytes = 8 * 1024 * 1024,
        [int] $Retries = 3
    )
    $sas = Split-SasUrl -SasUrl $SasUrl
    $Path = Resolve-FullPath -Path $Path
    $headers = @{ 'x-ms-version' = $script:BlobApiVersion }
    $ids = New-Object System.Collections.Generic.List[string]
    $fs = [IO.File]::OpenRead($Path)
    try {
        $n = 0
        while ($true) {
            $block = Read-StreamExact -Stream $fs -Count $BlockBytes
            if ($block.Length -eq 0 -and $n -gt 0) { break }
            $id = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes(('block-{0:d8}' -f $n)))
            $uri = Get-BlobUri -Sas $sas -BlobName $BlobName -Extra ('comp=block&blockid=' + [Uri]::EscapeDataString($id))
            $attempt = 0
            while ($true) {
                try {
                    $null = Invoke-WebRequest -Method Put -Uri $uri -Headers $headers -Body $block -ContentType 'application/octet-stream' -UseBasicParsing
                    break
                } catch {
                    $attempt++
                    if ($attempt -ge $Retries) { throw "upload of $BlobName failed at block $n after $Retries attempts" }
                    Start-Sleep -Seconds (2 * $attempt)
                }
            }
            $ids.Add($id)
            $n++
            if ($block.Length -lt $BlockBytes) { break }
        }
    } finally { $fs.Dispose() }
    $xml = '<?xml version="1.0" encoding="utf-8"?><BlockList>' + (($ids | ForEach-Object { "<Latest>$_</Latest>" }) -join '') + '</BlockList>'
    $uri = Get-BlobUri -Sas $sas -BlobName $BlobName -Extra 'comp=blocklist'
    $null = Invoke-WebRequest -Method Put -Uri $uri -Headers $headers -Body $xml -ContentType 'application/xml' -UseBasicParsing
}

function Get-BlobInventory {
    <#
    .SYNOPSIS
        name -> length for every blob under Prefix. Needs list permission.
    #>
    param([Parameter(Mandatory)] [string] $SasUrl, [string] $Prefix = '')
    $sas = Split-SasUrl -SasUrl $SasUrl
    $headers = @{ 'x-ms-version' = $script:BlobApiVersion }
    $result = @{}
    $marker = ''
    do {
        $uri = "$($sas.Base)?restype=container&comp=list&prefix=$([Uri]::EscapeDataString($Prefix))&$($sas.Query)"
        if ($marker) { $uri += '&marker=' + [Uri]::EscapeDataString($marker) }
        $resp = Invoke-WebRequest -Method Get -Uri $uri -Headers $headers -UseBasicParsing
        $text = $resp.Content
        if ($text -is [byte[]]) { $text = [Text.Encoding]::UTF8.GetString($text) }
        $text = $text.TrimStart([char]0xFEFF)
        $doc = [xml]$text
        foreach ($b in @($doc.EnumerationResults.Blobs.ChildNodes)) {
            if ($b.LocalName -eq 'Blob') { $result[$b.Name] = [long]$b.Properties.'Content-Length' }
        }
        $marker = [string]$doc.EnumerationResults.NextMarker
    } while ($marker)
    return $result
}

function Get-BlobFile {
    <#
    .SYNOPSIS
        Download one blob to a file.
    #>
    param([Parameter(Mandatory)] [string] $SasUrl, [Parameter(Mandatory)] [string] $BlobName, [Parameter(Mandatory)] [string] $Destination)
    $sas = Split-SasUrl -SasUrl $SasUrl
    $null = Invoke-WebRequest -Method Get -Uri (Get-BlobUri -Sas $sas -BlobName $BlobName) -Headers @{ 'x-ms-version' = $script:BlobApiVersion } -OutFile $Destination -UseBasicParsing
}

# ---------------------------------------------------------------------------
# Judging
# ---------------------------------------------------------------------------

function Get-BackupVerdict {
    <#
    .SYNOPSIS
        What a manifest says happened, as one of three answers:

          ok        every required component is present, encrypted, hashed
                    and non-empty, and the offsite copy landed.
          degraded  the local set is complete but no offsite copy was
                    attempted because no SAS is configured. A real gap -- one
                    copy, in the same room as its source -- so it exits
                    non-zero, but a different non-zero from a broken backup.
          failed    anything else, including an offsite upload that was tried
                    and did not finish, and a manifest still marked pending.

        Returns Verdict, Errors, Warnings. Exit codes: ok 0, failed 1,
        degraded 2.
    #>
    param([Parameter(Mandatory)] $Manifest)
    $errors = New-Object System.Collections.Generic.List[string]
    $warnings = New-Object System.Collections.Generic.List[string]

    $components = @()
    if ($Manifest.PSObject.Properties['components']) { $components = @($Manifest.components) }
    foreach ($req in $script:RequiredComponents) {
        $c = $components | Where-Object { $_.name -eq $req } | Select-Object -First 1
        if (-not $c) { $errors.Add("component $req is missing from the manifest"); continue }
        if ($c.status -ne 'ok') {
            $why = if ($c.PSObject.Properties['error'] -and $c.error) { ": $($c.error)" } else { '' }
            $errors.Add("component $req did not succeed (status $($c.status))$why")
            continue
        }
        if (-not $c.file -or -not ([string]$c.file).EndsWith($script:EncryptedSuffix)) {
            $errors.Add("component $req has no encrypted file recorded")
        }
        if (-not $c.bytes -or [long]$c.bytes -le 0) { $errors.Add("component $req is empty") }
        if (-not $c.sha256 -or ([string]$c.sha256).Length -ne 64) { $errors.Add("component $req has no SHA-256") }
        if ($c.PSObject.Properties['warnings']) { foreach ($w in @($c.warnings)) { if ($w) { $warnings.Add("${req}: $w") } } }
    }

    $offsite = if ($Manifest.PSObject.Properties['offsite']) { $Manifest.offsite } else { $null }
    $offsiteStatus = if ($offsite) { [string]$offsite.status } else { 'missing' }
    switch ($offsiteStatus) {
        'ok' { }
        'not-configured' { }
        'pending' { $errors.Add('offsite upload never reported - the run stopped between writing the set and uploading it') }
        'failed' {
            $n = if ($offsite.PSObject.Properties['failed']) { @($offsite.failed).Count } else { 0 }
            $errors.Add("offsite upload incomplete: $n file(s) failed")
        }
        default { $errors.Add("offsite status is '$offsiteStatus'") }
    }
    if ($offsite -and $offsite.PSObject.Properties['sas_expires_utc'] -and $offsite.sas_expires_utc) {
        $exp = [datetime]::Parse([string]$offsite.sas_expires_utc, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::AdjustToUniversal)
        $nowUtc = if ($Manifest.PSObject.Properties['created_utc'] -and $Manifest.created_utc) {
            [datetime]::Parse([string]$Manifest.created_utc, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::AdjustToUniversal)
        } else { [datetime]::UtcNow }
        $days = ($exp - $nowUtc).TotalDays
        if ($days -lt 14) { $warnings.Add(('the upload SAS expires in {0:N0} day(s) ({1:yyyy-MM-dd}) - mint a new one before it does' -f $days, $exp)) }
    }
    if ($Manifest.PSObject.Properties['errors']) { foreach ($e in @($Manifest.errors)) { if ($e) { $errors.Add([string]$e) } } }

    $verdict = 'ok'
    if ($errors.Count -gt 0) { $verdict = 'failed' }
    elseif ($offsiteStatus -eq 'not-configured') { $verdict = 'degraded' }
    return [pscustomobject]@{ Verdict = $verdict; Errors = @($errors); Warnings = @($warnings) }
}

function Get-VerdictExitCode {
    <#
    .SYNOPSIS
        Map a backup verdict to the exit code: ok 0, degraded 2, failed 1.
    #>
    param([Parameter(Mandatory)] [string] $Verdict)
    switch ($Verdict) { 'ok' { return 0 } 'degraded' { return 2 } default { return 1 } }
}

function ConvertFrom-SetName {
    <#
    .SYNOPSIS
        mykronos_20261018_030000 -> its local creation time, or $null.
    #>
    param([Parameter(Mandatory)] [string] $Name)
    if ($Name -notmatch $script:SetNamePattern) { return $null }
    return [datetime]::ParseExact($Matches[1] + $Matches[2], 'yyyyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture)
}

function Get-SetName {
    <#
    .SYNOPSIS
        The set name for a time: mykronos_yyyyMMdd_HHmmss.
    #>
    param([datetime] $At = (Get-Date))
    return 'mykronos_' + $At.ToString('yyyyMMdd_HHmmss', [Globalization.CultureInfo]::InvariantCulture)
}

function Select-BackupsToPrune {
    <#
    .SYNOPSIS
        Which local sets may be deleted. Input: objects with Name, Created and
        Success. The rule, after TheHub's 2026-07 outage, where a reaper kept
        deleting while the producer had silently stopped:

          * the newest MinKeep SUCCESSFUL sets are kept regardless of age, so
            retention can never take the last good copy;
          * everything else older than RetainDays goes, failed sets included;
          * nothing younger than RetainDays is touched.

        The caller only prunes after a run whose own verdict is ok.
    #>
    param(
        [Parameter(Mandatory)] [AllowEmptyCollection()] [object[]] $Sets,
        [int] $RetainDays = 7,
        [int] $MinKeep = 3,
        [datetime] $Now = (Get-Date)
    )
    $newestFirst = @($Sets | Sort-Object -Property Created -Descending)
    $keep = @($newestFirst | Where-Object { $_.Success } | Select-Object -First $MinKeep | ForEach-Object { $_.Name })
    $cutoff = $Now.AddDays(-$RetainDays)
    return @($newestFirst | Where-Object { $_.Created -lt $cutoff -and $keep -notcontains $_.Name } | ForEach-Object { $_.Name })
}

function Get-LocalBackupSet {
    <#
    .SYNOPSIS
        Every set directory under Root, newest first, with its manifest's success.
    #>
    param([Parameter(Mandatory)] [string] $Root)
    if (-not (Test-Path -LiteralPath $Root)) { return @() }
    $sets = foreach ($d in Get-ChildItem -LiteralPath $Root -Directory) {
        $created = ConvertFrom-SetName -Name $d.Name
        if ($null -eq $created) { continue }
        $success = $false
        $mf = Join-Path $d.FullName 'manifest.json'
        if (Test-Path -LiteralPath $mf) {
            try { $success = [bool]((Get-Content -Raw -LiteralPath $mf | ConvertFrom-Json).success) } catch { $success = $false }
        }
        [pscustomobject]@{ Name = $d.Name; Path = $d.FullName; Created = $created; Success = $success }
    }
    return @($sets | Sort-Object -Property Created -Descending)
}

function Get-DrillVerdict {
    <#
    .SYNOPSIS
        A drill is a list of checks, each pass / fail / inconclusive / skip.
        One fail fails the drill. Skip is a check that does not apply (the
        offsite listing when no read SAS is configured) and counts for
        nothing either way. Inconclusive (Docker unreachable, a tool image
        missing) says nothing about the backup and is reported as such, so a
        broken drill is never mistaken for a broken backup or a good one.
        Exit codes: pass 0, fail 1, inconclusive 2.
    #>
    param([Parameter(Mandatory)] [AllowEmptyCollection()] [object[]] $Checks)
    if ($Checks.Count -eq 0) { return [pscustomobject]@{ Verdict = 'fail'; ExitCode = 1; Failed = @('no checks ran') } }
    $failed = @($Checks | Where-Object { $_.status -eq 'fail' } | ForEach-Object { $_.name })
    if ($failed.Count -gt 0) { return [pscustomobject]@{ Verdict = 'fail'; ExitCode = 1; Failed = $failed } }
    $inconclusive = @($Checks | Where-Object { $_.status -ne 'pass' -and $_.status -ne 'skip' } | ForEach-Object { $_.name })
    if ($inconclusive.Count -gt 0) { return [pscustomobject]@{ Verdict = 'inconclusive'; ExitCode = 2; Failed = $inconclusive } }
    return [pscustomobject]@{ Verdict = 'pass'; ExitCode = 0; Failed = @() }
}

function Write-ManifestFile {
    <#
    .SYNOPSIS
        Write the manifest atomically (temp file, then rename).
    #>
    param([Parameter(Mandatory)] $Manifest, [Parameter(Mandatory)] [string] $Path)
    $tmp = "$Path.tmp"
    $Manifest | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $tmp -Encoding ascii
    Move-Item -LiteralPath $tmp -Destination $Path -Force
}

