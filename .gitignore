# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node ---
node_modules/
.next/
dist/

# --- Mykronos runtime state ---
# The data lake is local operational data, never source. See specs/05-datalake.md.
datalake/
*.duckdb
*.duckdb.wal

# Ingestion token registry holds token hashes + metadata (spec 12 §2).
# Never committed even though it contains no plaintext secrets.
tokens.json

# The operational store: token hashes, installation ids, the audit log.
# Same tier as tokens.json (spec 12 §2), and easy to miss — `*.duckdb` above
# covers the lake, but SQLite carries a different extension and the file only
# appears once someone runs against the default config rather than a scratch
# path. The -shm/-wal siblings are WAL-mode artefacts of the same database.
mykronos.db
mykronos.db-shm
mykronos.db-wal

# --- Secrets (spec 12 §8: no real secret is ever committed) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local scratch ---
Archive.zip

# --- Frontend ---
frontend/.next/
frontend/node_modules/
frontend/.env.local
frontend/openapi.json

# Concourse deployment secrets (deploy/concourse/README.md).
deploy/concourse/.env
deploy/concourse/.env.bak-*
deploy/concourse/bin/
deploy/concourse/keys/

# Vault unseal key and root token. Committing these makes the credential
# manager worthless; losing them makes every secret in it unrecoverable, so
# they belong in a password manager as well as here.
deploy/concourse/vault/init.json
deploy/concourse/vault/*.key
# Pre-Vault compose backup, kept on disk for the rollback in VAULT.md.
deploy/concourse/docker-compose.yml.bak-*

# TheHub deploy target (spec 16 §7). `.env` names this host's compose files;
# `.deployed-*` is the SHA each environment is currently on, which is the
# rollback target and is state rather than configuration.
deploy/thehub/.env
deploy/thehub/.deployed-*
deploy/thehub/.failed-*
# Written by the Scheduled Task's -Once cycles; capped in the script.
deploy/thehub/registry-pull-deploy.log
# Held open for the life of a deploy so two of them cannot interleave. Purely
# a runtime handle - it exists only while a deploy is in flight.
deploy/thehub/.deploy-lock-*
