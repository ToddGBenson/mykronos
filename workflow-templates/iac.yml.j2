{% extends "_base.yml.j2" %}
{#- IaC capability — spec 04 §3 (Checkov). Emits SARIF natively. -#}
{% block triggers %}
  pull_request:
    paths:
      - "**/*.tf"
      - "**/*.tfvars"
      - "cloudformation/**"
      - "k8s/**"
      - "**/*.yaml"
      - "**/*.yml"
  push:
    branches: ["<< default_branch >>"]
  workflow_dispatch:
{% endblock %}

{% block job_name %}Checkov{% endblock %}

{% block scan_steps %}
      - name: Scan infrastructure as code
        continue-on-error: true
        run: |
          mkdir -p "${{ runner.temp }}/mykronos-results"
          # `-w /repo` with `--directory .`, not `--directory /repo`, and the
          # difference is the whole of B-048. Checkov prefixes every SARIF
          # path with the basename of the directory it was pointed at, so
          # `--directory /repo` emitted `repo/.github/workflows/release.yml` --
          # a path that exists nowhere in the repository. It is not clickable
          # from a finding, it matches nothing a person greps for, and because
          # a finding's identity derives from its path (spec 05 §5) it also
          # made the same defect a different finding under each CI. Running
          # from inside the mount makes the paths repo-root-relative, which is
          # what the Concourse lane already produced.
          docker run --rm \
            -w /repo \
            -v "${{ github.workspace }}:/repo" \
            -v "${{ runner.temp }}/mykronos-results:/out" \
            bridgecrew/checkov:<< config.tool_version | default('3.2.334') >> \
            --directory . \
            --output sarif \
            --output-file-path /out \
            --soft-fail \
            --quiet
          # Checkov always names its file results.sarif. Rename it, so a repo
          # running several SARIF-emitting scanners cannot have one silently
          # overwrite another's output.
          if [ -f "${{ runner.temp }}/mykronos-results/results.sarif" ]; then
            mv "${{ runner.temp }}/mykronos-results/results.sarif" \
               "${{ runner.temp }}/mykronos-results/checkov.sarif"
          fi
{% endblock %}
