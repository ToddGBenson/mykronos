{%- extends "_base.yml.j2" -%}
{#-
  Atlas — supply-chain evidence (spec 07 §4).

  The only capability that writes to two places, and the reason `_base` has a
  post_upload block. Per-dependency vulnerabilities go in as ordinary Finding
  rows through the shared upload action, so they appear in the same portfolio
  views as SAST and DAST (spec 07 §3); the aggregate SscsEvidence summary is
  posted afterwards. Afterwards deliberately: a trust score recorded for
  findings that failed to upload would be evidence of a scan that did not
  land.

  Triggers differ from the base. A dependency tree does not change unless a
  manifest does, so pull requests are path-filtered — running osv-scanner on
  every documentation change would be minutes of runner time to re-derive an
  identical answer. Releases trigger too, for the SBOM and provenance that
  §2 requires on every tag.

  NOTE ON SHELL SYNTAX: no heredocs (see _base.yml.j2). `jq -n` builds JSON.
-#}

{% block triggers %}
  pull_request:
    # Manifests only. The dependency tree cannot change without one of these
    # changing, so anything else would re-derive the same answer (spec 07 §4).
    paths:
      - "**/package.json"
      - "**/package-lock.json"
      - "**/pnpm-lock.yaml"
      - "**/yarn.lock"
      - "**/requirements*.txt"
      - "**/pyproject.toml"
      - "**/poetry.lock"
      - "**/uv.lock"
      - "**/go.mod"
      - "**/go.sum"
      - "**/Gemfile.lock"
      - "**/Cargo.lock"
      - "**/pom.xml"
      - "**/build.gradle*"
  push:
    branches: ["<< default_branch >>"]
  release:
    types: [published]
  schedule:
    # New advisories land against dependencies that have not changed, which is
    # the one way this capability's answer goes stale without a commit.
    - cron: "<< config.schedule_cron | default('23 4 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_name %}Supply chain{% endblock %}
{% block tool_name %}osv-scanner{% endblock %}
{% block results_path %}${{ runner.temp }}/mykronos-results{% endblock %}

{% block scan_steps %}
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5.6.0
        with:
          python-version: "3.13"

      - name: Install Mykronos and the scanners
        run: |
          set -euo pipefail
          pip install --quiet '<< mykronos_package_spec >>'

      - name: Install OSV-Scanner
        # NOT `pip install osv-scanner` — that name on PyPI is a reserved
        # placeholder ("Reserved name placeholder. No functionality.", 0.0.1)
        # which installs cleanly and provides no CLI. Every Atlas run since
        # this lane shipped died on `osv-scanner: command not found`, was
        # swallowed by the old blanket `|| true`, and reported zero findings.
        # OSV-Scanner is a Go binary released on GitHub; pin the version and
        # verify the published checksum so a swapped artifact cannot land in
        # the one lane whose job is catching swapped artifacts.
        env:
          OSV_VERSION: "<< config.osv_version | default('2.5.0') >>"
          OSV_SHA256: "<< config.osv_sha256 | default('edcfc41d257db36148f065055655fe3fcfc434b0b423ea67468a84c207524e0c') >>"
        run: |
          set -euo pipefail
          curl -sSfL -o /usr/local/bin/osv-scanner \
            "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_amd64"
          echo "${OSV_SHA256}  /usr/local/bin/osv-scanner" | sha256sum -c -
          chmod +x /usr/local/bin/osv-scanner
          osv-scanner --version

      - name: Scan dependencies
        id: sca
        # `--recursive` is required, not a tuning knob: `scan source` looks
        # only at the directory it is given, and real repos keep their
        # manifests in subdirectories (backend/, frontend/). Without it the
        # scan walked the repo root, matched nothing, and exited 128 "no
        # packages found" — a clean-looking empty result. `.gitignore` is
        # honoured during the walk, so node_modules and friends stay out.
        #
        # `--no-resolve` disables transitive resolution of manifests, which
        # calls deps.dev. That call returns `rpc error: code = Internal` for
        # any requirements.txt containing sqlalchemy — reproduced down to a
        # one-line file at every version tested — and an extractor error is
        # exit 127, which fails the whole lane. It stayed invisible while the
        # scan also found vulnerabilities, because exit 1 outranks it; the
        # first repo to fix its last CVE turned a green lane red. Direct
        # manifest and lockfile scanning is unaffected and still finds
        # everything the advisories cover.
        #
        # Exit 1 means vulnerabilities were found, which is a result and not
        # an error, so that one code is tolerated. Everything else fails the
        # step: 127 is a general error, 128 means nothing was scanned, and a
        # capability that scanned nothing must not report a clean supply
        # chain (spec 04 §6). A blanket `|| true` here is what hid both of
        # the bugs above for the entire life of this lane.
        run: |
          set -uo pipefail
          mkdir -p "${{ runner.temp }}/mykronos-results"

          # `|| rc=$?` rather than a bare call: Actions runs this as
          # `bash -e`, so exit 1 would abort the step before the check below
          # ever ran. Putting the call in a compound exempts it from errexit
          # without disabling errexit for the rest of the script.
          # osv-scanner's exit codes conflate two states this lane must keep
          # apart. 128 with "No package sources found" means the repository
          # declares no dependencies — a docs repo, a shell-script repo, a
          # greenfield project before its first manifest. That is a legitimate
          # state, not an error and not a finding.
          #
          # Treating it as a failure costs both directions: the lane goes
          # permanently red for repos that will never have a manifest, so
          # operators learn to ignore it — and a genuinely broken scanner then
          # looks exactly like an empty repository.
          #
          # `--recursive` was added earlier for the same exit code, on the
          # assumption that manifests were merely in subdirectories. That fixes
          # the repos that have manifests somewhere. It cannot help a repo that
          # has none, and those exist.
          #
          # The SBOM step twenty lines below already gets this right: zero
          # components is a warning and an omitted artifact, not a dead lane.
          # This brings the SCA step into line with it.
          NO_PACKAGES=0

          run_osv() {
            local rc=0 out
            out="$(osv-scanner scan source --recursive --no-resolve "$@" . 2>&1)" || rc=$?
            printf '%s\n' "$out"

            # Exit 128 is overloaded, so match on the message rather than the
            # code alone: a different 128 is still a real failure.
            if [ "$rc" -eq 128 ] && printf '%s' "$out" | grep -qi 'no package sources found'; then
              NO_PACKAGES=1
              return 0
            fi

            if [ "$rc" -gt 1 ]; then
              echo "::error::osv-scanner exited ${rc} — that is a scan failure, not a findings result"
              exit "$rc"
            fi
          }

          run_osv --format sarif --output-file "${{ runner.temp }}/mykronos-results/osv.sarif"
          run_osv --format json --output-file osv.json

          if [ "$NO_PACKAGES" -eq 1 ]; then
            # Say it loudly. A silent empty result is the failure mode this
            # change could otherwise introduce, and a false green is worse than
            # the false red it replaces: nobody investigates a green lane.
            echo "::warning::No package sources found. This repository declares no" \
                 "dependencies for osv-scanner to read, so there is nothing to scan." \
                 "Recording an empty result — this is NOT a clean bill of health for" \
                 "dependencies that exist, it is a statement that none were declared."

            # A valid, explicitly-empty SARIF, so downstream reads "scanned,
            # found nothing" rather than "produced no output" — the latter is
            # what the upload step reports as a failure.
            #
            # printf rather than a heredoc ON PURPOSE. The heredoc operator is
            # also this template set's Jinja variable-start delimiter, so a
            # heredoc here is parsed as a template expression and the template
            # fails to compile. That applies to prose too: writing the operator
            # in a comment breaks the build just as surely, which is why this
            # note spells it out instead of quoting it. Do not "tidy" this back
            # into a heredoc.
            printf '%s' \
              '{"$schema":"https://json.schemastore.org/sarif-2.1.0.json",' \
              '"version":"2.1.0","runs":[{"tool":{"driver":{"name":"osv-scanner",' \
              '"informationUri":"https://github.com/google/osv-scanner","rules":[]}},' \
              '"results":[],"invocations":[{"executionSuccessful":true,' \
              '"exitCode":128,"exitCodeDescription":' \
              '"no package sources found - repository declares no dependencies"}]}]}' \
              > "${{ runner.temp }}/mykronos-results/osv.sarif"

            # Fail loudly if that JSON is malformed rather than shipping a
            # broken artifact that reads as evidence.
            python -c "import json,sys; json.load(open(sys.argv[1]))" \
              "${{ runner.temp }}/mykronos-results/osv.sarif"
          fi

          test -f osv.json || echo '{"results":[]}' > osv.json

      - name: Generate the SBOM
        # On releases and on the default branch, not on pull requests.
        #
        # §2 requires an SBOM per tag, and the first version stopped there —
        # which meant a repository that never cuts a release never produced
        # one at all, and its supply-chain evidence showed no SBOM with
        # nothing to say it was merely waiting for a tag. Most repositories
        # here do not tag. One per default-branch commit costs a file per push
        # and makes the evidence real for repos that ship continuously; pull
        # requests stay excluded, because thousands of near-identical SBOMs
        # from feature branches are archive noise rather than evidence.
        if: >-
          github.event_name == 'release' ||
          github.event_name == 'workflow_dispatch' ||
          (github.event_name == 'push' &&
           github.ref == 'refs/heads/<< default_branch >>')
        #
        # Syft, not cyclonedx-bom. `cyclonedx-py environment` documents the
        # *interpreter this workflow is running in* — which holds mykronos and
        # whatever pip pulled in with it, and has never looked at the
        # repository being scanned. It also sees only Python, on repositories
        # where osv-scanner routinely finds four ecosystems. The output would
        # have been a plausible SBOM of entirely the wrong software.
        #
        # It survived because it only ever ran on releases, and none of the
        # onboarded repositories tag releases, so it had never executed once.
        # Syft reads the repository itself, which also means `cyclonedx-bom`
        # no longer needs installing at all.
        run: |
          set -euo pipefail
          FORMAT="<< config.sbom_format | default('cyclonedx') >>"
          case "$FORMAT" in
            spdx)      SYFT_OUTPUT="spdx-json" ;;
            cyclonedx) SYFT_OUTPUT="cyclonedx-json" ;;
            *)
              echo "::error::Unknown sbom_format '$FORMAT'." >&2
              exit 1
              ;;
          esac

          # Pinned to an exact tag, never `latest`: an SBOM is evidence, and
          # evidence produced by an unknown version of the tool is worth less
          # than none.
          #
          # The excludes are for build and dependency directories that a clean
          # checkout should not contain anyway. They are insurance: cataloguing
          # a vendored tree turns a minute into tens of minutes and describes
          # software this repository does not ship.
          docker run --rm \
            -v "${{ github.workspace }}:/src:ro" \
            anchore/syft:v1.51.0 \
            scan dir:/src \
              --exclude './**/node_modules' \
              --exclude './**/.venv' \
              --exclude './**/venv' \
              --exclude './**/vendor' \
              --output "$SYFT_OUTPUT" > sbom.json

          COMPONENTS=$(jq '((.components // []) | length) + ((.packages // []) | length)' sbom.json)
          echo "SBOM lists $COMPONENTS component(s) in $SYFT_OUTPUT format"

          # An SBOM with nothing in it is not evidence, and archiving one is
          # worse than recording none: the dashboard would show an SBOM
          # present for a file that describes no software.
          #
          # Usually this means the repository pins nothing. Syft reads
          # resolved dependency sets — lockfiles, requirements.txt, installed
          # packages — and a project declaring ranges in pyproject.toml with
          # no lockfile has no resolved set to record. That is a fact about
          # the repository, not a tool failure, and the right response is to
          # say so rather than to emit a confident empty document.
          if [ "$COMPONENTS" -eq 0 ]; then
            echo "::warning::No components found. This repository has no" \
                 "lockfile or other resolved dependency set for syft to read," \
                 "so there is no bill of materials to record. Not archiving."
            rm -f sbom.json
          fi

      - name: Archive the SBOM
        id: sbom
        # Keyed on the file existing rather than repeating the condition
        # above. Two copies of the same `if:` is how they come to disagree,
        # and the failure mode is a curl against a file that is not there.
        if: hashFiles('sbom.json') != ''
        run: |
          set -euo pipefail
          REF=$(curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/ingest/raw?scan_run_id=${{ github.run_id }}&capability=<< capability >>&filename=sbom.json" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/octet-stream" \
            --data-binary @sbom.json | jq -r '.raw_output_ref')
          echo "ref=$REF" >> "$GITHUB_OUTPUT"
{% endblock %}

{% block post_upload %}
      - name: Report supply-chain evidence
        # Always, so a scan that failed still records what it managed to see
        # rather than leaving the repo with stale evidence and no sign of it.
        if: always()
        env:
          SBOM_REF: ${{ steps.sbom.outputs.ref }}
          TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail

          # Counts, not a score. The trust formula lives in the platform so it
          # is reproducible and cannot drift between action versions
          # (spec 07 §5, §7).
          ECOSYSTEMS=$(python -m mykronos.atlas_counts osv.json)

          PROVENANCE=$(jq -nc \
            --arg builder "github-actions" \
            --arg repo "${{ github.repository }}" \
            --arg commit "${{ github.sha }}" \
            --arg run_id "${{ github.run_id }}" \
            --arg runner "${{ runner.os }}-${{ runner.arch }}" \
            --arg workflow "${{ github.workflow }}" \
            '{builder_id: $builder, source_repo: $repo, source_commit: $commit,
              build_run_id: $run_id, runner: $runner, workflow: $workflow}')

          BODY=$(jq -nc \
            --arg commit "${{ github.sha }}" \
            --arg tag "$TAG" \
            --arg sbom "$SBOM_REF" \
            --argjson ecosystems "$ECOSYSTEMS" \
            --argjson provenance "$PROVENANCE" \
            '{commit_sha: $commit, ecosystems: $ecosystems, provenance: $provenance}
             + (if $tag == "" then {} else {tag_or_release: $tag} end)
             + (if $sbom == "" then {} else {sbom_ref: $sbom} end)')

          curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/ingest/atlas" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/json" \
            -d "$BODY" > evidence.json

          TRUST=$(jq -r '.trust_score' evidence.json)
          MINIMUM=$(jq -r '.min_trust_score' evidence.json)
          BELOW=$(jq -r '.below_minimum' evidence.json)
          BLOCKING=$(jq -r '.blocking' evidence.json)
          DEPS=$(jq -r '.dependency_count' evidence.json)
          VULN=$(jq -r '.vulnerable_dependency_count' evidence.json)

          # A null score means the scan resolved no dependencies, so nothing
          # was assessed (spec 07 §5a). Printing "null/100" or quietly reading
          # it as zero would both be wrong; this is the state where a repo
          # declaring version ranges rather than pinned versions used to be
          # told its supply chain scored a perfect 100.
          if [ "$TRUST" = "null" ]; then
            echo "::warning::No dependencies resolved - supply-chain trust not assessed."
            {
              echo "## Mykronos Atlas - not assessed"
              echo
              echo "The scan resolved no dependencies, so no trust score was"
              echo "computed. This is not a clean result. Check that manifests"
              echo "pin versions and that the scanner was allowed to resolve"
              echo "them; a scan that inspected nothing cannot clear a floor."
            } >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi

          echo "Supply-chain trust: $TRUST/100 ($VULN vulnerable of $DEPS dependencies)"

          {
            echo "## Mykronos Atlas - trust $TRUST/100"
            echo
            echo "$VULN vulnerable of $DEPS dependencies. Repository floor: $MINIMUM."
          } >> "$GITHUB_STEP_SUMMARY"

          # spec 07 §6: with blocking on, a release below the floor fails.
          # Only a release — failing a pull request because a transitive
          # dependency has an advisory nobody on this PR introduced is how
          # this capability gets switched off.
          if [ "$BLOCKING" = "true" ] && [ "$BELOW" = "true" ] \
             && [ "${{ github.event_name }}" = "release" ]; then
            echo "::error::Trust score $TRUST is below this repository's floor of $MINIMUM."
            exit 1
          fi

          if [ "$BELOW" = "true" ]; then
            echo "::warning::Trust score $TRUST is below this repository's floor of $MINIMUM (advisory)."
          fi
{% endblock %}
