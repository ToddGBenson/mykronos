{% extends "_base.yml.j2" %}
{#-
  SAST for shell — B-051.

  A second `sast` lane, running beside the CodeQL one rather than instead of
  it. CodeQL implements no shell language at all, so a shell-heavy repository
  running only CodeQL reports success over code nothing has read: `keel` had
  47 successful SAST runs and zero findings while 69% of it went unexamined.

  Two lanes on one capability is how "alongside" is expressed here. Both
  upload `sast`, `CAPABILITY_BY_JOB` maps both job names to it, and the
  coverage cross-check sees each of them as the capability reporting.
-#}
{% block triggers %}
  pull_request:
    paths:
      - "**/*.sh"
      - "**/*.bash"
      - "**/*.ksh"
      - "**/*.zsh"
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('41 4 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_name %}ShellCheck{% endblock %}

{#- Reports `sast`, not `sast-shell`: this is a second lane on one capability,
    not a capability of its own. A repository does not gain a new thing to
    enable by adding an analyser. -#}
{% block upload_capability %}sast{% endblock %}
{% block tool_name %}shellcheck{% endblock %}

{% block scan_steps %}
      - name: Find shell scripts
        id: shell
        # By extension *and* by shebang. A repository's most interesting
        # scripts are frequently the ones with no extension -- an installer
        # called `bootstrap`, a hook called `pre-commit` -- and a scan that
        # only globs `*.sh` misses exactly those while reporting success.
        #
        # `.git` is excluded explicitly: it holds sample hooks that ship with
        # git itself, and reporting findings about somebody else's templates
        # is how a new lane's first run reads as noise.
        run: |
          set -uo pipefail
          {
            find . -path ./.git -prune -o -type f \
              \( -name '*.sh' -o -name '*.bash' -o -name '*.ksh' -o -name '*.zsh' \) -print
            find . -path ./.git -prune -o -type f -perm -u+x -print \
              | while read -r candidate; do
                  head -c 64 "$candidate" 2>/dev/null \
                    | grep -qE '^#!.*\b(bash|sh|ksh|zsh)\b' && echo "$candidate"
                done
          } | sed 's|^\./||' | sort -u > "${{ runner.temp }}/shell-files.txt"

          count=$(wc -l < "${{ runner.temp }}/shell-files.txt" | tr -d ' ')
          echo "count=${count}" >> "$GITHUB_OUTPUT"
          echo "Found ${count} shell script(s)."

      - name: Scan shell scripts
        # Never fails the step itself: exit codes are the upload step's job,
        # which applies this repo's configured threshold and blocking policy
        # (spec 04 §5). ShellCheck exits 1 whenever it has anything to say,
        # and this lane is expected to have something to say.
        continue-on-error: true
        run: |
          set -uo pipefail
          mkdir -p "${{ runner.temp }}/mykronos-results"

          if [ ! -s "${{ runner.temp }}/shell-files.txt" ]; then
            # An empty report rather than no report. A capability with nothing
            # to scan must still say it looked, or the lane reads as never
            # having run and the cross-check cannot tell the two apart
            # (spec 04 §6).
            echo '{"comments":[]}' > "${{ runner.temp }}/mykronos-results/shellcheck.json"
            echo "::notice::No shell scripts here, so ShellCheck had nothing to read."
            exit 0
          fi

          # `--severity=style` reports everything ShellCheck has, and the
          # filtering happens in Mykronos against this repository's configured
          # threshold (spec 04 §5). A scanner that drops findings before the
          # platform sees them makes the threshold unadjustable without a
          # re-render, and makes "no findings" ambiguous between a clean scan
          # and a narrow one.
          #
          # Mounted read-only: a linter has no reason to write to the tree it
          # is reading, and the scanner is the one step in this workflow
          # running somebody else's container over our source.
          docker run --rm \
            -w /repo \
            -v "${{ github.workspace }}:/repo:ro" \
            koalaman/shellcheck:v<< config.tool_version | default('0.10.0') >> \
            --format=json1 --severity=style \
            $(tr '\n' ' ' < "${{ runner.temp }}/shell-files.txt") \
            > "${{ runner.temp }}/mykronos-results/shellcheck.json"
          rc=$?

          # 1 means ShellCheck had something to say, which is a result rather
          # than an error -- this lane exists to have something to say.
          # Everything else is the scanner failing, and blanket-ignoring the
          # exit code would report a clean scan for a scan that broke: the
          # hollow green the pipeline standard forbids (PS-3). The guard test
          # greps the raw step, so this comment does not name the operator it
          # is warning about.
          if [ "$rc" -gt 1 ]; then
            echo "::error::ShellCheck exited ${rc} — the scan did not complete."
            exit "$rc"
          fi

          # ShellCheck writes nothing at all when the container cannot start.
          # An empty file parses as zero findings, which would report a clean
          # scan for a scan that did not happen.
          if [ ! -s "${{ runner.temp }}/mykronos-results/shellcheck.json" ]; then
            echo "::error::ShellCheck produced no output — the scan did not run."
            exit 1
          fi
{% endblock %}
