{% extends "_base.yml.j2" %}
{#-
  SAST capability — spec 04 §3 (CodeQL).

  Refactored onto the shared base in template v1.1.0. The rendered output is
  materially the same; what changed is that the header, fail-fast probe and
  upload step are no longer duplicated per capability.
-#}
{% block triggers %}
  pull_request:
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('17 3 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_permissions %}
  actions: read
  security-events: read
{% endblock %}

{% block job_name %}CodeQL (${{ matrix.language }}){% endblock %}

{% block job_strategy %}
    strategy:
      # One language failing to build must not hide findings in the others.
      fail-fast: false
      matrix:
        language: << languages | tojson >>
{% endblock %}

{% block scan_steps %}
      - name: Initialize CodeQL
        id: init
        uses: github/codeql-action/init@ce5e7eeac396d720fe2d802714996c8ce561e311  # v3.39.0
        with:
          languages: ${{ matrix.language }}
          queries: << config.queries | default('security-extended') >>
{%- if config.get('paths_include') %}
          config: |
            paths:
{%- for path in config.get('paths_include') %}
              - "<< path >>"
{%- endfor %}
{%- if config.get('paths_exclude') %}
            paths-ignore:
{%- for path in config.get('paths_exclude') %}
              - "<< path >>"
{%- endfor %}
{%- endif %}
{%- endif %}

      - name: Autobuild
        uses: github/codeql-action/autobuild@ce5e7eeac396d720fe2d802714996c8ce561e311  # v3.39.0

      - name: Analyze
        uses: github/codeql-action/analyze@ce5e7eeac396d720fe2d802714996c8ce561e311  # v3.39.0
        with:
          category: "/language:${{ matrix.language }}"
          output: ${{ runner.temp }}/mykronos-results
          # Mykronos is the system of record for findings (spec 05 §1), so we
          # take the SARIF ourselves rather than routing it to code scanning.
          upload: false
{% endblock %}

{% block tool_name %}codeql{% endblock %}

{% block post_upload %}
{%- if config.import_reachability | default(true) %}
      - name: Import reachability
        # Which Python files nothing in the repository imports (spec 19 §2.1).
        #
        # Not reachability in the call-graph sense, and the platform says so
        # everywhere it surfaces this. It answers one narrow question that is
        # nonetheless true, where spec 17 §5.3 correctly declined to answer a
        # much harder one falsely.
        #
        # Under sast because reachability is a fact about source code and
        # sast is the capability whose findings it prioritises. A capability
        # of its own would mean a separate grant for something with no
        # findings and no workflow to enable.
        #
        # Runs once per workflow, not once per matrix language: the analysis
        # is Python-only and the matrix would post the same result several
        # times, each overwriting the last.
        if: matrix.language == 'python' || matrix.language == 'javascript-typescript'
        continue-on-error: true
        run: |
          set -uo pipefail
          python -m pip install --quiet '<< mykronos_package_spec >>' || exit 0
          python -m mykronos.reachability . \
            --commit-sha "${{ github.sha }}" > reachability.json || exit 0

          echo "Analysed $(jq -r '.files_analysed' reachability.json) Python file(s);" \
               "$(jq -r '.orphaned_paths | length' reachability.json) orphaned."

          curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/ingest/reachability" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/json" \
            -d @reachability.json > /dev/null
{%- endif %}
{%- if config.dataflow_reachability | default(true) %}

      - name: Dataflow reachability
        # Is the vulnerable package called from an entry point, and is it used
        # at all (TheHub #60891). Runs Mykronos's own CodeQL queries over the
        # database the Analyze step just built, with the CLI the init step
        # downloaded: no second analyser, nothing else fetched.
        #
        # A reachable verdict carries the call path CodeQL traced. Unreachable
        # means never imported, with the evidence; "no path found" is never
        # unreachable, because CodeQL's call graph is incomplete. The platform
        # re-checks that evidence before anything acts on it.
        #
        # Never fails the scan: reachability is an input to triage, and losing
        # it must not lose the findings the scan already uploaded. Its own time
        # limit keeps a slow pass over a large database from running the job
        # into the job's limit after those findings were uploaded.
        #
        # Default branch only: the platform keeps one report per repository and
        # language, with no ref, so a pull request's tree would replace the
        # default branch's verdicts and triage would act on a branch.
        if: (matrix.language == 'python' || matrix.language == 'javascript-typescript') && github.event_name != 'pull_request' && github.ref == 'refs/heads/<< default_branch >>'
        continue-on-error: true
        timeout-minutes: << config.dataflow_reachability_timeout_minutes | default(10) >>
        env:
          CODEQL: ${{ steps.init.outputs.codeql-path }}
          MATRIX_LANGUAGE: ${{ matrix.language }}
        run: |
          set -uo pipefail
          lang="python"
          [ "$MATRIX_LANGUAGE" = "python" ] || lang="javascript"
          db="$RUNNER_TEMP/codeql_databases/$lang"
          [ -d "$db" ] || db="$RUNNER_TEMP/codeql_databases/$MATRIX_LANGUAGE"
          if [ ! -d "$db" ]; then
            echo "::warning::No CodeQL database at $db; dataflow reachability skipped."
            exit 0
          fi
          python -m pip install --quiet '<< mykronos_package_spec >>' || exit 0
          queries="$RUNNER_TEMP/mykronos-reachability-queries"
          python -m mykronos.reachability_dataflow --language "$lang" \
            --write-queries "$queries" > /dev/null || exit 0

          "$CODEQL" database analyze "$db" "$queries" \
            --format=sarif-latest --output="$RUNNER_TEMP/mykronos-reachability.sarif" \
            --threads=0 || exit 0

          python -m mykronos.reachability_dataflow --language "$lang" \
            --sarif "$RUNNER_TEMP/mykronos-reachability.sarif" \
            --analysis-sarif-dir "${{ runner.temp }}/mykronos-results" \
            --root . --commit-sha "${{ github.sha }}"
{%- if config.get('paths_include') or config.get('paths_exclude') %} \
            --scoped
{%- endif %} > dataflow-reachability.json || exit 0

          for verdict in reachable unreachable unknown; do
            echo "Dataflow reachability ($lang): $(jq --arg v "$verdict" \
              '[.verdicts[] | select(.verdict == $v)] | length' dataflow-reachability.json) $verdict"
          done

          curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/ingest/reachability/dataflow" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/json" \
            -d @dataflow-reachability.json > /dev/null
{%- endif %}
{% endblock %}
