{#-
  SAST capability -- spec 04 §3 (CodeQL), spec 03 §2.

  Jinja variables are << like this >>, not {{ like this }}, because GitHub
  Actions expressions are ${{ ... }} and Jinja would otherwise try to evaluate
  every one of them. Remapping the delimiters keeps the workflow readable as a
  workflow instead of burying it in {% raw %} blocks.
-#}
# Generated by Mykronos Workflow Installer — template version: << template_version >>
# Capability: sast · Repo: << repo_full_name >>
#
# Do not edit by hand. A template resync will overwrite this file (spec 03 §6).
# To change behaviour, edit this repo's SAST capability config in Mykronos.

name: Mykronos SAST

on:
  pull_request:
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('17 3 * * 1') >>"
  workflow_dispatch:

permissions:
  contents: read
  actions: read
  security-events: read

concurrency:
  group: mykronos-sast-${{ github.ref }}
  cancel-in-progress: true

jobs:
  sast:
    name: CodeQL (${{ matrix.language }})
    runs-on: ubuntu-latest
    timeout-minutes: << config.timeout_minutes | default(30) >>
    strategy:
      fail-fast: false
      matrix:
        language: << languages | tojson >>

    steps:
      - name: Check out the code
        uses: actions/checkout@v4
        with:
          # Full history: the adapter reads surrounding source to build the
          # snippet fingerprint that gives a finding a stable identity
          # (spec 05 §5).
          fetch-depth: 0

      - name: Fail fast if Mykronos is unreachable
        # spec 05 §4. Better to stop in ten seconds than analyse for twenty
        # minutes and discover at upload time that the findings have nowhere
        # to go -- and a silent skip is not an option (spec 01 §6).
        run: |
          curl --fail --silent --show-error --max-time 20 \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            "<< ingestion_api_url >>/api/ingest/health" > /dev/null

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: ${{ matrix.language }}
          queries: << config.queries | default('security-extended') >>
{%- if config.get('paths_include') %}
          config: |
            paths:
{%- for path in config.get('paths_include') %}
              - "<< path >>"
{%- endfor %}
{%- if config.get('paths_exclude') %}
            paths-ignore:
{%- for path in config.get('paths_exclude') %}
              - "<< path >>"
{%- endfor %}
{%- endif %}
{%- endif %}

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Analyze
        uses: github/codeql-action/analyze@v3
        with:
          category: "/language:${{ matrix.language }}"
          output: ${{ runner.temp }}/codeql-results
          # Mykronos is the system of record for findings (spec 05 §1), so we
          # take the SARIF ourselves rather than routing it to code scanning.
          upload: false

      - name: Upload results to Mykronos
        # Shared composite action, semver-pinned: this repo is one of many
        # that depend on it, so it must never be referenced by branch
        # (spec 04 §2).
        uses: << upload_action_ref >>
        with:
          capability: sast
          tool: codeql
          tool-version: ${{ steps.codeql-version.outputs.version || 'unknown' }}
          results-path: ${{ runner.temp }}/codeql-results
          ingestion-url: << ingestion_api_url >>
          token: ${{ secrets.<< token_secret_name >> }}
          severity-threshold: << config.severity_threshold | default('low') >>
          blocking: "<< config.blocking | default(false) | lower >>"
