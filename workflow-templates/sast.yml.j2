{% extends "_base.yml.j2" %}
{#-
  SAST capability — spec 04 §3 (CodeQL).

  Refactored onto the shared base in template v1.1.0. The rendered output is
  materially the same; what changed is that the header, fail-fast probe and
  upload step are no longer duplicated per capability.
-#}
{% block triggers %}
  pull_request:
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('17 3 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_permissions %}
  actions: read
  security-events: read
{% endblock %}

{% block job_name %}CodeQL (${{ matrix.language }}){% endblock %}

{% block job_strategy %}
    strategy:
      # One language failing to build must not hide findings in the others.
      fail-fast: false
      matrix:
        language: << languages | tojson >>
{% endblock %}

{% block scan_steps %}
      - name: Initialize CodeQL
        uses: github/codeql-action/init@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6
        with:
          languages: ${{ matrix.language }}
          queries: << config.queries | default('security-extended') >>
{%- if config.get('paths_include') %}
          config: |
            paths:
{%- for path in config.get('paths_include') %}
              - "<< path >>"
{%- endfor %}
{%- if config.get('paths_exclude') %}
            paths-ignore:
{%- for path in config.get('paths_exclude') %}
              - "<< path >>"
{%- endfor %}
{%- endif %}
{%- endif %}

      - name: Autobuild
        uses: github/codeql-action/autobuild@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6

      - name: Analyze
        uses: github/codeql-action/analyze@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6
        with:
          category: "/language:${{ matrix.language }}"
          output: ${{ runner.temp }}/mykronos-results
          # Mykronos is the system of record for findings (spec 05 §1), so we
          # take the SARIF ourselves rather than routing it to code scanning.
          upload: false
{% endblock %}

{% block tool_name %}codeql{% endblock %}

{% block post_upload %}
{%- if config.import_reachability | default(true) %}
      - name: Import reachability
        # Which Python files nothing in the repository imports (spec 19 §2.1).
        #
        # Not reachability in the call-graph sense, and the platform says so
        # everywhere it surfaces this. It answers one narrow question that is
        # nonetheless true, where spec 17 §5.3 correctly declined to answer a
        # much harder one falsely.
        #
        # Under sast because reachability is a fact about source code and
        # sast is the capability whose findings it prioritises. A capability
        # of its own would mean a separate grant for something with no
        # findings and no workflow to enable.
        #
        # Runs once per workflow, not once per matrix language: the analysis
        # is Python-only and the matrix would post the same result several
        # times, each overwriting the last.
        if: matrix.language == 'python' || matrix.language == 'javascript-typescript'
        continue-on-error: true
        run: |
          set -uo pipefail
          python -m pip install --quiet '<< mykronos_package_spec >>' || exit 0
          python -m mykronos.reachability . \
            --commit-sha "${{ github.sha }}" > reachability.json || exit 0

          echo "Analysed $(jq -r '.files_analysed' reachability.json) Python file(s);" \
               "$(jq -r '.orphaned_paths | length' reachability.json) orphaned."

          curl --fail --silent --show-error --max-time 60 \
            -X POST "<< ingestion_api_url >>/api/ingest/reachability" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/json" \
            -d @reachability.json > /dev/null
{%- endif %}
{% endblock %}
