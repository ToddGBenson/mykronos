{% extends "_base.yml.j2" %}
{#-
  SAST capability — spec 04 §3 (CodeQL).

  Refactored onto the shared base in template v1.1.0. The rendered output is
  materially the same; what changed is that the header, fail-fast probe and
  upload step are no longer duplicated per capability.
-#}
{% block triggers %}
  pull_request:
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('17 3 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_permissions %}
  actions: read
  security-events: read
{% endblock %}

{% block job_name %}CodeQL (${{ matrix.language }}){% endblock %}

{% block job_strategy %}
    strategy:
      # One language failing to build must not hide findings in the others.
      fail-fast: false
      matrix:
        language: << languages | tojson >>
{% endblock %}

{% block scan_steps %}
      - name: Initialize CodeQL
        uses: github/codeql-action/init@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6
        with:
          languages: ${{ matrix.language }}
          queries: << config.queries | default('security-extended') >>
{%- if config.get('paths_include') %}
          config: |
            paths:
{%- for path in config.get('paths_include') %}
              - "<< path >>"
{%- endfor %}
{%- if config.get('paths_exclude') %}
            paths-ignore:
{%- for path in config.get('paths_exclude') %}
              - "<< path >>"
{%- endfor %}
{%- endif %}
{%- endif %}

      - name: Autobuild
        uses: github/codeql-action/autobuild@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6

      - name: Analyze
        uses: github/codeql-action/analyze@c4dd10e44af883a891fe31ced449bcb4a6728b9b  # v3.37.6
        with:
          category: "/language:${{ matrix.language }}"
          output: ${{ runner.temp }}/mykronos-results
          # Mykronos is the system of record for findings (spec 05 §1), so we
          # take the SARIF ourselves rather than routing it to code scanning.
          upload: false
{% endblock %}

{% block tool_name %}codeql{% endblock %}
