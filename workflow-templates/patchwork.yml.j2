{#-
  Patchwork — auto-remediation (spec 08 §6).

  Does not extend _base.yml.j2. Patchwork runs no scanner and uploads no
  findings: the pipeline runs server-side, so the workflow's whole job is to
  ask for a run once the scanners have reported and to relay the answer into
  the run log.

  Server-side is spec 08 §6's choice, and a good one. The pipeline reads the
  data lake, consults the Knowledge Store, and — when configured — spends
  money on a model. All three want to be observable in one place rather than
  scattered across every onboarded repository's runner.

  `workflow_run` for the same reason as the Oracle gate: running on
  `pull_request` would race the scanners and triage an empty finding set,
  producing a confident "nothing to fix" that means nothing.

  NOTE ON SHELL SYNTAX: no heredocs (see _base.yml.j2). `jq -n` builds JSON.
-#}
# Generated by Mykronos Workflow Installer — template version: << template_version >>
# Capability: patchwork · Repo: << repo_full_name >>
#
# Do not edit by hand. A template resync will overwrite this file (spec 03 §6).

name: Mykronos patchwork

on:
  workflow_run:
    # Only the scanners whose findings this repository feeds to Patchwork. A
    # workflow_run trigger naming a workflow that does not exist never fires,
    # so the installer renders only what is enabled.
    workflows:
{%- for workflow in gate_depends_on %}
      - "<< workflow >>"
{%- endfor %}
    types: [completed]
  schedule:
    # Sweep the existing backlog (spec 08 §6). Weekly rather than daily: a
    # draft pull request nobody has looked at is not improved by being joined
    # by another one, and backpressure would queue it anyway.
    - cron: "<< config.schedule_cron | default('37 5 * * 2') >>"
  workflow_dispatch:

permissions:
  contents: read
  # Deliberately minimal. Patchwork's branch and pull request are created by
  # the *backend* using the App installation token, not by this workflow —
  # this job only asks for a run and reads the result. Granting the workflow
  # write access it does not use would be handing a token to every action in
  # the job for no reason.

concurrency:
  group: mykronos-patchwork-<< repo_full_name >>
  # Not cancel-in-progress: a run that is midway through opening draft pull
  # requests should finish doing so rather than leave half of them.
  cancel-in-progress: false

jobs:
  remediate:
    name: Auto-remediation
    runs-on: ubuntu-latest
    timeout-minutes: << config.timeout_minutes | default(20) >>

    steps:
      - name: Ask Patchwork for a run
        run: |
          set -euo pipefail

          BODY=$(jq -nc \
            --arg sha "${{ github.event.workflow_run.head_sha || github.sha }}" \
            '{commit_sha: $sha}')

          curl --fail --silent --show-error --max-time 300 \
            -X POST "<< ingestion_api_url >>/api/patchwork/run" \
            -H "Authorization: Bearer ${{ secrets.<< token_secret_name >> }}" \
            -H "Content-Type: application/json" \
            -d "$BODY" > result.json

          OPENED=$(jq -r '.draft_prs_opened' result.json)
          QUEUED=$(jq -r '.queued' result.json)
          CONSIDERED=$(jq -r '.findings_considered' result.json)

          echo "Patchwork considered $CONSIDERED finding(s): opened $OPENED draft PR(s), queued $QUEUED"
          jq -r '.by_stage | to_entries[] | "  \(.key): \(.value)"' result.json

          {
            echo "## Mykronos Patchwork"
            echo
            echo "$CONSIDERED finding(s) considered · $OPENED draft pull request(s) opened · $QUEUED queued"
            echo
            jq -r '.by_stage | to_entries[] | "- \(.key): \(.value)"' result.json
            echo
            echo "Every pull request is a draft and stays that way. Patchwork"
            echo "cannot merge — the client it uses exposes no merge operation."
          } >> "$GITHUB_STEP_SUMMARY"

          # Errors are reported, never fatal. spec 08 §8: a pipeline that
          # broke partway still recorded where each finding got to, and
          # failing the workflow would hide that behind a red X.
          if [ "$(jq -r '.errors | length' result.json)" != "0" ]; then
            jq -r '.errors[]' result.json | while read -r line; do
              echo "::warning::Patchwork: $line"
            done
          fi
