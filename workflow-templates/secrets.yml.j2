{% extends "_base.yml.j2" %}
{#-
  Secrets capability — spec 04 §3 (Gitleaks).

  The one scanner whose findings *are* the sensitive data. `--redact` is not
  optional here: without it the secret value lands in the tool output, the raw
  archive, and every finding record derived from them. The adapter refuses to
  attach a code snippet for this capability for the same reason.
-#}
{% block triggers %}
  pull_request:
  push:
    branches: ["<< default_branch >>"]
  schedule:
    - cron: "<< config.schedule_cron | default('23 4 * * 1') >>"
  workflow_dispatch:
{% endblock %}

{% block job_name %}Gitleaks{% endblock %}

{% block scan_steps %}
      - name: Scan for secrets
        # Never fails the step itself: exit codes are the upload step's job,
        # which applies this repo's configured threshold and blocking policy
        # (spec 04 §5). A scanner deciding CI outcomes on its own bypasses that.
        continue-on-error: true
        run: |
          mkdir -p "${{ runner.temp }}/mykronos-results"
          docker run --rm \
            -v "${{ github.workspace }}:/repo" \
            -v "${{ runner.temp }}/mykronos-results:/out" \
            zricethezav/gitleaks:v<< config.tool_version | default('8.18.4') >> \
            detect --source /repo \
                   --report-format json \
                   --report-path /out/gitleaks.json \
                   --redact \
                   --exit-code 0 \
                   --no-banner
{% endblock %}
