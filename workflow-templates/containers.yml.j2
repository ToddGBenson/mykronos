{% extends "_base.yml.j2" %}
{#- Containers capability — spec 04 §3 (Trivy).

    Builds each Dockerfile in the repository and scans the resulting image,
    rather than scanning the working tree.

    The first version ran `trivy filesystem /repo --scanners vuln,misconfig,
    secret`, which never builds or pulls anything. That reads lockfiles and
    Dockerfiles already in the repo and cannot see the base image's OS
    packages, the layers a build adds, or anything installed by a RUN line —
    which is most of what container scanning exists to find. It also
    duplicated two other capabilities: `misconfig` overlaps Checkov (iac) and
    `secret` overlaps Gitleaks (secrets), so a repo with all three enabled got
    the same finding three times under three rule ids.

    `--scanners vuln` only, here. Dockerfile misconfiguration belongs to iac,
    and the repo's secrets belong to secrets. -#}

{% block triggers %}
  pull_request:
    paths:
      - "**/Dockerfile*"
      - "**/*.dockerfile"
      - "**/docker-compose*.y*ml"
      - "**/requirements*.txt"
      - "**/package-lock.json"
      - "**/poetry.lock"
      - "**/go.sum"
  push:
    branches: ["<< default_branch >>"]
  schedule:
    # Daily, and this is the capability where that matters most: the image
    # does not change, and the set of vulnerabilities known about it does.
    - cron: "<< config.schedule_cron | default('41 2 * * *') >>"
  workflow_dispatch:
{% endblock %}

{% block job_name %}Trivy{% endblock %}

{% block scan_steps %}
      - name: Find Dockerfiles
        id: discover
        # NOTE: bash array-length syntax -- dollar, brace, hash -- must not
        # appear in this file. Those three characters open a Jinja comment
        # that never closes, and the template fails to compile with "Missing
        # end of comment tag" pointing at a line that is not the problem.
        # (Writing the sequence out literally in a comment does it too, which
        # is how the first attempt at this very note failed.)
        #
        # `_base.yml.j2` remaps Jinja's *variable* delimiters for the same
        # class of collision with GitHub's expression syntax; comment
        # delimiters are still the default, so the shell has to avoid them.
        # Counting lines in a file sidesteps it entirely.
        run: |
          set -euo pipefail
          LIST="${{ runner.temp }}/dockerfiles.txt"
          # Excludes dependency and fixture directories: scanning a vendored
          # example Dockerfile reports vulnerabilities in an image this repo
          # never builds and never ships.
          find . \
            \( -path ./.git -o -path '*/node_modules' -o -path '*/.venv' \
               -o -path '*/vendor' -o -path '*/testdata' \) -prune -o \
            \( -name 'Dockerfile' -o -name 'Dockerfile.*' -o -name '*.dockerfile' \) \
            -type f -print | sort > "$LIST"
          COUNT=$(wc -l < "$LIST" | tr -d ' ')
          echo "Found $COUNT Dockerfile(s)"
          cat "$LIST"
          {
            echo "count=$COUNT"
            echo "list=$LIST"
          } >> "$GITHUB_OUTPUT"

      - name: Build and scan each image
        # A repo with no Dockerfile is not a failure (spec 04 §6). The step
        # writes an empty SARIF, the adapter reports a clean scan, and the
        # lake can still tell "scanned, nothing to scan" from "never ran".
        #
        # A build failure is also not a scan failure. The repository's own CI
        # owns whether the image builds; reporting that here would mean this
        # capability goes red for a reason that has nothing to do with
        # vulnerabilities, and a check that is red for unrelated reasons stops
        # being read.
        continue-on-error: true
        env:
          LIST: ${{ steps.discover.outputs.list }}
          COUNT: ${{ steps.discover.outputs.count }}
        run: |
          set -uo pipefail
          OUT="${{ runner.temp }}/mykronos-results"
          mkdir -p "$OUT"
          EMPTY_SARIF='{"version":"2.1.0","$schema":"https://json.schemastore.org/sarif-2.1.0.json","runs":[{"tool":{"driver":{"name":"Trivy"}},"results":[]}]}'

          if [ "$COUNT" -eq 0 ]; then
            echo "No Dockerfile in this repository — nothing to build."
            printf '%s' "$EMPTY_SARIF" > "$OUT/trivy-empty.sarif"
            exit 0
          fi

          INDEX=0
          while IFS= read -r DOCKERFILE; do
            [ -n "$DOCKERFILE" ] || continue
            INDEX=$((INDEX + 1))

            # The image name carries the Dockerfile, and that is load-bearing
            # rather than cosmetic. Trivy writes the image reference into the
            # SARIF `artifactLocation`, which becomes the finding's file path,
            # which is part of its identity (spec 05 §5).
            #
            # The first version tagged every image `mykronos-scan:<sha>-N`, so
            # every finding from every image recorded the same path
            # `library/mykronos-scan`. The same CVE in Dockerfile and
            # Dockerfile.hardened collapsed into one row: 600 results became
            # 118. There was no way to tell whether the hardened image had
            # fixed anything, which is the only reason to build one.
            #
            # Docker repository names allow lowercase alphanumerics and
            # `._-/`, so the path is folded rather than passed through.
            SAFE=$(printf '%s' "$DOCKERFILE" \
              | sed 's|^\./||' \
              | tr '[:upper:]' '[:lower:]' \
              | sed 's|[^a-z0-9]\+|-|g; s|^-*||; s|-*$||')
            TAG="mykronos-scan/${SAFE}:${{ github.sha }}"

            echo "::group::Building $DOCKERFILE"
            # Two contexts, in order: the Dockerfile's own directory, then the
            # repository root.
            #
            # `dirname` alone was wrong for a very ordinary layout, and this
            # repository is an example of it. `backend/Dockerfile` COPYs
            # `backend/pyproject.toml`, `workflow-templates` and
            # `maturity-model-v1.yaml` — paths that only resolve from the root
            # — so a `backend` context dies at the first COPY that leaves it.
            # A monorepo whose images pull in shared files fails the same way.
            #
            # That mattered more here than a failed build normally would,
            # because this step swallows failures by design: the repository's
            # own CI owns whether an image builds, so an unbuildable
            # Dockerfile is skipped rather than failing the scan. The result
            # was a `containers` lane reporting a clean scan of zero images —
            # green, and meaningless. Exactly the "reported nothing and looked
            # fine" failure this platform exists to catch, in the platform's
            # own product.
            #
            # The root is tried second rather than first because it is the
            # wider blast radius: it sends every file in the repository to the
            # daemon, and for a self-contained Dockerfile that is pure cost.
            BUILT=""
            for CONTEXT in "$(dirname "$DOCKERFILE")" "."; do
              if docker build --quiet --file "$DOCKERFILE" --tag "$TAG" "$CONTEXT"; then
                BUILT="$CONTEXT"
                break
              fi
              echo "  (context '$CONTEXT' did not build; trying the next)"
            done

            if [ -z "$BUILT" ]; then
              echo "::warning::Could not build $DOCKERFILE from its own" \
                   "directory or from the repository root — skipping it. The" \
                   "repository's own CI owns whether this image builds."
              echo "::endgroup::"
              continue
            fi
            echo "  built from context '$BUILT'"
            echo "::endgroup::"

            # One SARIF per image as well, so a partial failure loses one
            # image's results rather than all of them.
            docker run --rm \
              -v /var/run/docker.sock:/var/run/docker.sock \
              -v "$OUT:/out" \
              aquasec/trivy:<< config.tool_version | default('0.58.1') >> \
              image "$TAG" \
                --scanners vuln \
                --format sarif \
                --output "/out/trivy-$SAFE.sarif" \
                --exit-code 0 \
                --quiet
          done < "$LIST"

          if ! ls "$OUT"/*.sarif >/dev/null 2>&1; then
            # Every build failed. Still a completed scan of zero images, not a
            # silent nothing: the adapter needs a file, and the lake needs to
            # be able to tell this from a run that never happened.
            echo "::warning::No image was scannable; recording an empty result."
            printf '%s' "$EMPTY_SARIF" > "$OUT/trivy-empty.sarif"
          fi

      - name: Install Mykronos, to enumerate the deployed images
        # Only to run `mykronos.estate_images` in the step below. The upload
        # action installs its own copy from the same spec, and duplicating the
        # install here rather than sharing it is what keeps this step's failure
        # from taking the upload with it.
        run: python -m pip install --quiet '<< mykronos_package_spec >>'

      - name: Scan the images this repository's compose files run
        # #427. Everything above scans images this repository *builds*, and in
        # the estate that raised this, that was four images out of fifteen. The
        # other eleven — Vault, MinIO, Concourse, Postgres, Redis, nginx and a
        # `registry:2` last built in 2023 — are pulled rather than built, so no
        # Dockerfile names them and nothing had ever looked at them. The lake
        # showed it as an absence: across every container scan ever recorded,
        # for any repository, not one `musl`, `busybox`, `apk-tools`, `nginx`,
        # `redis` or `postgres` package.
        #
        # The list is derived from the compose files rather than configured,
        # because a list of images in this repo's capability config is the same
        # defect one level up: right when it is written, silently short the
        # first time somebody adds a service. An image joins this scan by being
        # deployed.
        #
        # No Docker socket. Trivy pulls the image from its registry itself,
        # which is also why this works for an image the runner never built.
        env:
          TRIVY: aquasec/trivy:<< config.tool_version | default('0.58.1') >>
        run: |
          set -uo pipefail
          OUT="${{ runner.temp }}/mykronos-results"
          mkdir -p "$OUT"
          LIST="${{ runner.temp }}/estate-images.txt"

          python -m mykronos.estate_images --root . --output "$LIST"

          FAILED=""
          while IFS= read -r IMAGE; do
            [ -n "$IMAGE" ] || continue

            # The image reference becomes the finding's path and therefore part
            # of its identity (spec 05 §5), so the report file is named after
            # it too: one file per image, and never a shared one. A shared tag
            # is how 600 container results once became 118.
            SAFE=$(printf '%s' "$IMAGE" \
              | tr '[:upper:]' '[:lower:]' \
              | sed 's|[^a-z0-9]\+|-|g; s|^-*||; s|-*$||')

            echo "::group::Scanning $IMAGE"
            if ! docker run --rm -v "$OUT:/out" "$TRIVY" \
              image "$IMAGE" \
                --scanners vuln \
                --format sarif \
                --output "/out/trivy-estate-$SAFE.sarif" \
                --exit-code 0 \
                --quiet; then
              FAILED="$FAILED $IMAGE"
            fi
            echo "::endgroup::"
          done < "$LIST"

          if [ -n "$FAILED" ]; then
            # Named, and fatal. A deployed image that could not be scanned is
            # not a clean deployed image, and swallowing it would put this lane
            # back where the issue found it — reporting confidently on a subset
            # and looking identical to full coverage.
            echo "::error::Trivy could not scan:$FAILED"
            exit 1
          fi
{% endblock %}
